@using System.Text.RegularExpressions
@inject BankService Bank
@inject CurrentUserAccessor Users
@inject ISnackbar Snackbar

<MudPaper Class="pa-6 mb-6">
    <MudText Typo="Typo.h6">Add questions from an HTML file</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">Import to the shared question bank and create random sets without AI. Imported content is supplied by you, not verified by CSC.</MudText>

    <MudFileUpload T="IBrowserFile" Accept=".html,.htm" OnFilesChanged="PreviewFile" Hidden="false" Disabled="@_isProcessing" Class="mt-4"
                   Style="position:relative;display:block;"
                   InputStyle="@AppTheme.FileInputOverlayStyle">
        <ActivatorContent>
            <MudPaper Outlined="true" Class="@($"{AppTheme.CardPadding} text-center")" Style="@AppTheme.DropZoneStyle">
                <MudIcon Icon="@Icons.Material.Filled.UploadFile" Color="Color.Primary" />
                <MudText>Drop an HTML reviewer here, or choose a file</MudText>
            </MudPaper>
        </ActivatorContent>
    </MudFileUpload>
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
        Maximum 2 MB. Supports the supplied CSE_2027_Reviewer.html and the <MudLink Href="/import-template.html" Typo="Typo.caption" download>downloadable import template</MudLink>. Future files need the template's JSON format. Legacy questions use Easy difficulty; numerical explanations are preserved as supplied.
    </MudText>

    @if (_isReading) {
        <MudProgressLinear Indeterminate="true" Class="mt-4" />
    }
    @if (_preview != null) {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-4">
            <div>@PreviewSummary</div>
            <div>@string.Join(" · ", _preview.Categories.Select(c => $"{c.Category}: {c.Count}"))</div>
        </MudAlert>
        @if (_preview.Issues.Count > 0) {
            <MudExpansionPanels Class="mt-2">
                <MudExpansionPanel Text="Review excluded questions">
                    @foreach (var issue in _preview.Issues) {
                        <MudText Typo="Typo.body2">@issue</MudText>
                    }
                </MudExpansionPanel>
            </MudExpansionPanels>
        }
    } else if (_message.Length > 0) {
        <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" Class="mt-4">@_message</MudAlert>
    }
    <MudStack Row="true" Spacing="2" Class="mt-4">
        @if (_pendingInput != null) {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_isProcessing" OnClick="ConfirmImport" StartIcon="@(_isProcessing ? null : Icons.Material.Filled.CloudUpload)">
                @if (_isProcessing) {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Import valid questions &amp; create a practice set
            </MudButton>
        }
        @if (_createdSetId != null) {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@("/Practice/" + _createdSetId)" EndIcon="@Icons.Material.Filled.ArrowForward">Start the new practice set</MudButton>
        }
    </MudStack>

    <MudPaper Outlined="true" Class="pa-4 mt-4">
        <MudText Typo="Typo.subtitle2">Questions saved in your imported database bank</MudText>
        <MudText Typo="Typo.h3" Color="Color.Primary">@BankTotalText</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary">Questions available to all study accounts. Repeated questions and copies in saved practice sets are not counted again.</MudText>
    </MudPaper>

    @if (_bankRows == null) {
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-4">@_bankMessage</MudText>
    } else if (_bankRows.Count == 0) {
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-4">Your imported bank is empty. Choose a file to preview it.</MudText>
    } else {
        <MudText Typo="Typo.overline" Class="mt-4">Imported question bank · all exam levels</MudText>
        <MudSimpleTable Dense="true" Hover="true" Outlined="true">
            <thead>
                <tr>
                    <th>Subject</th>
                    @foreach (var difficulty in Difficulties) {
                        <th style="@AppTheme.NumberCellStyle">@difficulty</th>
                    }
                    <th style="@AppTheme.NumberCellStyle">Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var subject in Subjects) {
                    <tr>
                        <td>@subject</td>
                        @foreach (var difficulty in Difficulties) {
                            <td style="@AppTheme.NumberCellStyle">@CountFor(subject, difficulty).ToString("N0")</td>
                        }
                        <td style="@AppTheme.NumberCellStyle"><strong>@_bankRows.Where(r => r.Category == subject).Sum(r => r.Count).ToString("N0")</strong></td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td><strong>Total questions</strong></td>
                    @foreach (var difficulty in Difficulties) {
                        <td style="@AppTheme.NumberCellStyle"><strong>@_bankRows.Where(r => r.Difficulty == difficulty).Sum(r => r.Count).ToString("N0")</strong></td>
                    }
                    <td style="@AppTheme.NumberCellStyle"><strong>@_bankRows.Sum(r => r.Count).ToString("N0")</strong></td>
                </tr>
            </tfoot>
        </MudSimpleTable>
    }
</MudPaper>

@code {
    #region Properties
    [Parameter] public EventCallback OnBankUpdated { get; set; }
    private const int _maxFileBytes = 2_000_000;
    private List<BankSummaryRow>? _bankRows;
    private ImportPreview? _preview;
    private ImportInput? _pendingInput;
    private Guid? _createdSetId;
    private string _userId = "";
    private string _message = "";
    private string _bankMessage = "Loading…";
    private int _previewVersion;
    private bool _isProcessing;
    private bool _isReading;
    private string BankTotalText => _bankRows == null ? _bankMessage : _bankRows.Sum(r => r.Count).ToString("N0");
    private string PreviewSummary => $"{_preview!.Title}: {_preview.Valid} valid unique questions. {_preview.NewQuestions} new to your bank; {_preview.Valid - _preview.NewQuestions} already stored; {_preview.Duplicates} repeated within the file; {_preview.Issues.Count} invalid and excluded.";
    private List<string> Difficulties {
        get {
            var all = new List<string> { "Easy", "Moderate", "Hard" };
            all.AddRange(_bankRows!.Select(r => r.Difficulty).Distinct().Where(d => !all.Contains(d)));
            return all;
        }
    }
    private List<string> Subjects => _bankRows!.Select(r => r.Category).Distinct().Order().ToList();
    #endregion

    #region Lifecycle
    protected override async Task OnInitializedAsync() {
        _userId = (await Users.Get()).Id;
        await LoadBankSummary();
    }
    #endregion

    #region Methods
    private int CountFor(string subject, string difficulty) {
        return _bankRows!.Where(r => r.Category == subject && r.Difficulty == difficulty).Sum(r => r.Count);
    }

    private async Task LoadBankSummary() {
        try { _bankRows = await Bank.GetBankSummary(); }
        catch (Exception ex) { _bankRows = null; _bankMessage = "Unavailable. " + ex.Message; }
    }

    private async Task PreviewFile(InputFileChangeEventArgs e) {
        var version = ++_previewVersion;
        _pendingInput = null;
        _preview = null;
        _createdSetId = null;
        _message = "";
        var file = e.File;
        if (!Regex.IsMatch(file.Name, @"\.html?$", RegexOptions.IgnoreCase) || file.Size > _maxFileBytes) {
            _message = "Choose an HTML file smaller than 2 MB.";
            return;
        }
        _isReading = true;
        try {
            using var reader = new StreamReader(file.OpenReadStream(_maxFileBytes));
            var input = new ImportInput(file.Name, await reader.ReadToEndAsync());
            var result = await Bank.PreviewImport(_userId, input);
            if (version != _previewVersion) return;
            if (!result.IsSuccess) { _message = result.Error.Length > 0 ? result.Error : "You do not have permission to import questions."; return; }
            _preview = result.Value;
            if (_preview!.Valid > 0) _pendingInput = input;
        } catch (Exception ex) {
            if (version == _previewVersion) Extension.ShowAlert(ex.Message, Variant.Filled, Snackbar, Severity.Error);
        } finally {
            _isReading = false;
        }
    }

    private async Task ConfirmImport() {
        if (_pendingInput == null || _isProcessing) return;
        _isProcessing = true;
        try {
            var result = await Bank.ImportQuestions(_userId, _pendingInput);
            if (!result.IsSuccess) { Extension.ShowAlert(result.Error, Variant.Filled, Snackbar, Severity.Error); return; }
            var summary = result.Value!;
            _pendingInput = null;
            _preview = null;
            _createdSetId = summary.Id;
            _message = $"{summary.Added:N0} new questions saved. Total in your imported database bank: {summary.TotalQuestions:N0}. Skipped {summary.Duplicates} duplicates and {summary.Skipped} invalid entries. Created a practice set of {summary.Count} questions.";
            await LoadBankSummary();
            await OnBankUpdated.InvokeAsync();
        } catch (Exception ex) {
            Extension.ShowAlert(ex.Message, Variant.Filled, Snackbar, Severity.Error);
        } finally {
            _isProcessing = false;
        }
    }
    #endregion
}
