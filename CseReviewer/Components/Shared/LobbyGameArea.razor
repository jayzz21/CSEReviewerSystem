@if (View.Status == "waiting") {
    <p>Share the link or code. The host can start when at least two players are ready.</p>
} else if (View.Status == "cancelled") {
    <h2 class="text-xl font-bold">Lobby closed</h2>
    <button type="button" class="secondary mt-4" @onclick="OnCloseLobby">Create or join another lobby</button>
} else if (View.Status == "finished") {
    @if (WaitingForHost) {
        <p>Waiting for the host to open the next game. Stay here. The same lobby link and players will be kept. You will need to mark yourself ready again.</p>
    } else {
        <h2 class="text-2xl font-bold">@FinishedTitle</h2>
        @if (IsHost) {
            <p class="mt-4">🎮 Use <strong>New game · back to lobby</strong> to restart with the same players and a reshuffled question set. Use <strong>Close lobby &amp; leave</strong> when done.</p>
        } else {
            <p class="mt-4">🔄 Choose <strong>Back to lobby</strong> to wait for the host to start another game, or <strong>Leave lobby</strong> to exit.</p>
        }
        <h3 class="font-bold mt-6">Your answer review</h3>
        @foreach (var result in View.Results ?? []) {
            <details class="mt-4">
                <summary>@(result.Index + 1). @result.Question.Prompt</summary>
                <p>Your answer: @(result.Choice == null ? "Not answered" : result.Question.Options[result.Choice.Value])</p>
                <p>Correct: @result.Question.Options[result.Question.Answer]</p>
                <p>@result.Question.Explanation</p>
                @foreach (var step in result.Question.Steps) {
                    <p>@step</p>
                }
            </details>
        }
    }
} else if (View.Review != null) {
    var reviewed = View.Review.Question.Question;
    <p class="eyebrow">ROUND @(View.Index + 1) COMPLETE</p>
    <h2 class="text-xl font-bold mt-3">@RoundResultTitle</h2>
    <p class="mt-4">@reviewed.Prompt</p>
    <p class="font-bold mt-3">Correct answer: @reviewed.Options[reviewed.Answer]</p>
    <p class="mt-3">@reviewed.Explanation</p>
    @foreach (var step in reviewed.Steps) {
        <p class="mt-2">@step</p>
    }
    <p class="mt-4">The next round starts automatically.</p>
} else if (View.Question == null) {
    <p>You have finished. Waiting for other players or the timer to end.</p>
} else {
    <p class="eyebrow">@View.Question.Category · QUESTION @(View.Index + 1)/@View.Count</p>
    <h2 class="text-xl font-bold mt-4">@View.Question.Prompt</h2>
    <div class="space-y-3 mt-6">
        @for (var i = 0; i < View.Question.Options.Length; i++) {
            var choice = i;
            <button type="button" class="option @(SelectedChoice == choice ? "selected" : "")" disabled="@View.Answered" @onclick="() => OnChoiceSelected.InvokeAsync(choice)">@("ABCD"[choice]). @View.Question.Options[choice]</button>
        }
    </div>
    <button type="button" class="primary mt-4" disabled="@(SelectedChoice == null || View.Answered || IsProcessing)" @onclick="OnSubmitAnswer">Submit answer</button>
    <p class="mt-4">@(View.Answered ? "Incorrect. You are out for this round; wait for the next one." : "You can submit only once. The server decides whether your answer arrived before time expired.")</p>
}

@code {
    #region Properties
    [Parameter, EditorRequired] public LobbyView View { get; set; } = default!;
    [Parameter] public bool WaitingForHost { get; set; }
    [Parameter] public int? SelectedChoice { get; set; }
    [Parameter] public bool IsProcessing { get; set; }
    [Parameter] public EventCallback<int> OnChoiceSelected { get; set; }
    [Parameter] public EventCallback OnSubmitAnswer { get; set; }
    [Parameter] public EventCallback OnCloseLobby { get; set; }
    private bool IsHost => View.Host == View.Me;
    #endregion

    #region Methods
    private string FinishedTitle {
        get {
            if (View.Winners.Length == 0) return "Match finished — no winning score";
            var names = string.Join(", ", View.Players.Where(p => View.Winners.Contains(p.Id)).Select(p => p.Name));
            return $"{(View.Winners.Length > 1 ? "Draw" : "Winner")}: {names}";
        }
    }

    private string RoundResultTitle {
        get {
            var winner = View.Players.FirstOrDefault(p => p.Id == View.Review!.Result.Winner);
            return winner != null ? winner.Name + " wins this round" : View.Review!.Result.Reason;
        }
    }
    #endregion
}
