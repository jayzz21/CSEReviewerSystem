@inherits LayoutComponentBase
@inject CurrentUserAccessor Users
@inject PracticeService Practice
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<AppProviders @bind-IsDarkMode="_isDarkMode" />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" aria-label="Open or close the menu" />
        <MudText Typo="Typo.h6" Class="ml-2">husay.</MudText>
        <MudSpacer />
        <MudHidden Breakpoint="Breakpoint.SmAndDown">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Inherit">PH Civil Service Exam</MudChip>
        </MudHidden>
        <MudTooltip Text="@(_isDarkMode ? "Switch to light mode" : "Switch to dark mode")">
            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)" Color="Color.Inherit" OnClick="ToggleDarkMode" aria-label="Toggle dark mode" />
        </MudTooltip>
    </MudAppBar>
    <MudDrawer @bind-Open="_isDrawerOpen" Elevation="1" Variant="DrawerVariant.Responsive" ClipMode="DrawerClipMode.Always">
        <MudText Typo="Typo.overline" Class="px-4 pt-4">Your study space</MudText>
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.AutoAwesome">Create a reviewer</MudNavLink>
            <MudNavLink Href="/My-Saved-Sets" Icon="@Icons.Material.Filled.Bookmarks">
                My saved sets
                @if (_savedCount > 0) {
                    <MudChip T="string" Size="Size.Small" Class="ml-2">@_savedCount</MudChip>
                }
            </MudNavLink>
            <MudNavLink Href="/Multiplayer" Icon="@Icons.Material.Filled.Groups">Multiplayer lobbies</MudNavLink>
            @if (_user?.IsAdmin == true) {
                <MudNavLink Href="/Administration" Icon="@Icons.Material.Filled.AdminPanelSettings">Administration</MudNavLink>
            }
            <MudNavLink OnClick="SignOut" Icon="@Icons.Material.Filled.Logout">Sign out</MudNavLink>
        </MudNavMenu>
        <div style="margin-top:auto" class="pa-4">
            <MudPaper Outlined="true" Class="pa-4">
                <MudText Typo="Typo.subtitle2">Small steps. Big progress.</MudText>
                <MudText Typo="Typo.body2" Class="mt-1">A little practice today brings you closer to public service.</MudText>
                <MudText Typo="Typo.overline" Color="Color.Primary" Class="mt-2">Para sa pangarap. Para sa bayan.</MudText>
            </MudPaper>
            <MudText Typo="Typo.caption" Class="mt-3">Signed in as @(string.IsNullOrEmpty(_user?.Name) ? "-" : _user.Name)</MudText>
        </div>
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="AppTheme.PageMaxWidth" Class="@AppTheme.PageSpacing">
            @Body
            <MudDivider Class="mt-10 mb-3" />
            <div class="d-flex flex-wrap justify-space-between gap-3">
                <MudText Typo="Typo.caption">Husay · A little better, every day.</MudText>
                <MudLink Href="https://www.csc.gov.ph/more-than-400k-to-take-26-march-career-service-exam" Target="_blank" Typo="Typo.caption">CSC coverage reference</MudLink>
            </div>
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    #region Properties
    private CurrentUser? _user;
    private int _savedCount;
    private bool _isDarkMode;
    private bool _isDrawerOpen = true;
    #endregion

    #region Lifecycle
    protected override async Task OnInitializedAsync() {
        _user = await Users.Get();
        Navigation.LocationChanged += OnLocationChanged;
        await LoadSavedCount();
    }

    public void Dispose() {
        Navigation.LocationChanged -= OnLocationChanged;
    }
    #endregion

    #region Methods
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) {
        _ = InvokeAsync(async () => {
            await LoadSavedCount();
            StateHasChanged();
        });
    }

    private async Task LoadSavedCount() {
        if (_user == null) return;
        _savedCount = (await Practice.GetSavedSets(_user.Id)).Count;
    }

    private void ToggleDrawer() {
        _isDrawerOpen = !_isDrawerOpen;
    }

    private async Task ToggleDarkMode() {
        _isDarkMode = !_isDarkMode;
        await JS.InvokeVoidAsync("localStorage.setItem", AppTheme.DarkModeStorageKey, _isDarkMode ? "true" : "false");
    }

    private void SignOut() {
        Navigation.NavigateTo("/Logout", forceLoad: true);
    }
    #endregion
}
