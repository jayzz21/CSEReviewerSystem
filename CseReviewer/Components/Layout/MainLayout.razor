@inherits LayoutComponentBase
@inject CurrentUserAccessor Users
@inject PracticeService Practice
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

<AppProviders @bind-IsDarkMode="_isDarkMode" />

<MudLayout>
    <MudAppBar Elevation="0" Class="masthead" Fixed="true">
        <MudIconButton Icon="@Icons.Material.Outlined.Menu" Class="masthead-menu" Edge="Edge.Start" OnClick="ToggleMenu" aria-label="Open the menu" />
        <a href="/" class="wordmark">Husay</a>
        <nav class="masthead-nav" aria-label="Main">
            <a href="/" class="masthead-link @ActiveClass(IsPracticePage)">Practice</a>
            <a href="/My-Saved-Sets" class="masthead-link @ActiveClass(IsPage("/My-Saved-Sets"))">Saved sets@(_savedCount > 0 ? $" ({_savedCount})" : "")</a>
            <a href="/Multiplayer" class="masthead-link @ActiveClass(IsPage("/Multiplayer"))">Multiplayer</a>
            @if (_user?.IsAdmin == true) {
                <a href="/Administration" class="masthead-link @ActiveClass(IsPage("/Administration"))">Administration</a>
            }
        </nav>
        <MudSpacer />
        <span class="who">@(string.IsNullOrEmpty(_user?.Name) ? "-" : _user.Name)</span>
        <MudTooltip Text="@(_isDarkMode ? "Switch to light mode" : "Switch to dark mode")">
            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)" OnClick="ToggleDarkMode" aria-label="Toggle dark mode" />
        </MudTooltip>
        <MudButton Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Outlined.Logout" OnClick="SignOut" Class="ml-1">Sign out</MudButton>
    </MudAppBar>
    <MudDrawer @bind-Open="_isMenuOpen" Variant="DrawerVariant.Temporary" Elevation="0" Anchor="Anchor.Start">
        <MudText Typo="Typo.overline" Class="px-4 pt-5 pb-2">Menu</MudText>
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All">Practice</MudNavLink>
            <MudNavLink Href="/My-Saved-Sets">Saved sets@(_savedCount > 0 ? $" ({_savedCount})" : "")</MudNavLink>
            <MudNavLink Href="/Multiplayer">Multiplayer</MudNavLink>
            @if (_user?.IsAdmin == true) {
                <MudNavLink Href="/Administration">Administration</MudNavLink>
            }
        </MudNavMenu>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="px-4 mt-4">Signed in as @(string.IsNullOrEmpty(_user?.Name) ? "-" : _user.Name)</MudText>
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="AppTheme.PageMaxWidth" Class="@AppTheme.PageSpacing">
            @Body
            <hr class="rule mt-12" />
            <div class="d-flex flex-wrap justify-space-between gap-3 mt-4">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Husay is a practice reviewer. It is not an official Civil Service Commission exam.</MudText>
                <MudLink Href="https://www.csc.gov.ph/more-than-400k-to-take-26-march-career-service-exam" Target="_blank" Typo="Typo.caption" Color="Color.Secondary">CSC coverage reference</MudLink>
            </div>
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    #region Properties
    private CurrentUser? _user;
    private int _savedCount;
    private string _currentPath = "/";
    private bool _isDarkMode;
    private bool _isMenuOpen;
    private bool IsPracticePage => IsPage("/") || IsPage("/Practice");
    #endregion

    #region Lifecycle
    protected override async Task OnInitializedAsync() {
        _user = await Users.Get();
        _currentPath = CurrentPath();
        Navigation.LocationChanged += OnLocationChanged;
        await LoadSavedCount();
    }

    public void Dispose() {
        Navigation.LocationChanged -= OnLocationChanged;
    }
    #endregion

    #region Methods
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) {
        _ = InvokeAsync(async () => {
            _currentPath = CurrentPath();
            _isMenuOpen = false;
            await LoadSavedCount();
            StateHasChanged();
        });
    }

    private async Task LoadSavedCount() {
        if (_user == null) return;
        _savedCount = (await Practice.GetSavedSets(_user.Id)).Count;
    }

    private string CurrentPath() {
        return "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');
    }

    private bool IsPage(string path) {
        return path == "/" ? _currentPath == "/" : _currentPath.StartsWith(path, StringComparison.OrdinalIgnoreCase);
    }

    private static string ActiveClass(bool isActive) => isActive ? "is-active" : "";

    private void ToggleMenu() {
        _isMenuOpen = !_isMenuOpen;
    }

    private async Task ToggleDarkMode() {
        _isDarkMode = !_isDarkMode;
        await JS.InvokeVoidAsync("localStorage.setItem", AppTheme.DarkModeStorageKey, _isDarkMode ? "true" : "false");
    }

    private void SignOut() {
        Navigation.NavigateTo("/Logout", forceLoad: true);
    }
    #endregion
}
