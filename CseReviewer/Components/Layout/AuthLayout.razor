@inherits LayoutComponentBase
@inject IJSRuntime JS

<AppProviders @bind-IsDarkMode="_isDarkMode" />

<MudLayout>
    <MudAppBar Elevation="0" Class="masthead" Fixed="true">
        <a href="/" class="wordmark">Husay</a>
        <MudSpacer />
        <MudTooltip Text="@(_isDarkMode ? "Switch to light mode" : "Switch to dark mode")">
            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)" OnClick="ToggleDarkMode" aria-label="Toggle dark mode" />
        </MudTooltip>
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="AppTheme.PageMaxWidth" Class="auth-stage">
            <MudGrid Spacing="8" Class="py-8">
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.overline" Color="Color.Primary">Civil Service Examination review</MudText>
                    <MudText Typo="Typo.h2" Class="mt-3">Practice by subject.<br />Learn from every answer.</MudText>
                    <MudText Class="mt-5 measure" Color="Color.Secondary">Work through questions by subject and level, read the worked explanation after each one, and save a set to finish later. Your progress stays with your account.</MudText>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudPaper Elevation="0" Class="@AppTheme.LargePanel">
                        @Body
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    #region Properties
    private bool _isDarkMode;
    #endregion

    #region Methods
    private async Task ToggleDarkMode() {
        _isDarkMode = !_isDarkMode;
        await JS.InvokeVoidAsync("localStorage.setItem", AppTheme.DarkModeStorageKey, _isDarkMode ? "true" : "false");
    }
    #endregion
}
