@page "/Multiplayer"
@attribute [Authorize]
@implements IDisposable
@inject LobbyService Lobbies
@inject LobbyNotifier Notifier
@inject CurrentUserAccessor Users
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Multiplayer · Husay</PageTitle>

<div class="page-head">
    <MudText Typo="Typo.overline" Color="Color.Primary">Multiplayer</MudText>
    <MudText Typo="Typo.h3" Class="mt-1">Answer the same questions together</MudText>
    <MudText Color="Color.Secondary" Class="mt-3 measure">Create a lobby and share its code, or join one with a code you were given. Everyone gets the same questions, and the server keeps the time.</MudText>
</div>

@if (_isLoading) {
    <MudProgressLinear Indeterminate="true" />
} else if (_view == null) {
    <MudGrid Spacing="8">
        <MudItem xs="12" md="6">
            <div>
                <MudText Typo="Typo.overline" Class="section-label">Create a lobby</MudText>
                <form @onsubmit="CreateNewLobby">
                    <MudStack Spacing="3" Class="mt-4">
                        <MudSelect T="string" Label="Exam level" Variant="Variant.Outlined" Value="@_level" ValueChanged="@ChangeLevel">
                            <MudSelectItem T="string" Value="@("Professional")" />
                            <MudSelectItem T="string" Value="@("Subprofessional")" />
                        </MudSelect>
                        <MudSelect T="string" Label="Category" Variant="Variant.Outlined" @bind-Value="_category">
                            @foreach (var category in GetCategories()) {
                                <MudSelectItem T="string" Value="@category" />
                            }
                        </MudSelect>
                        <MudSelect T="string" Label="Game mode" Variant="Variant.Outlined" @bind-Value="_mode" ToStringFunc="@ModeLabel">
                            <MudSelectItem T="string" Value="@("test")" />
                            <MudSelectItem T="string" Value="@("speed")" />
                        </MudSelect>
                        <MudNumericField T="int" Label="Number of questions" Variant="Variant.Outlined" Min="30" Max="180" Class="text-align-right" HideSpinButtons="true" @bind-Value="_count" Immediate="true" />
                        <MudNumericField T="int" Label="@(_mode == "speed" ? "Minutes per question" : "Minutes for the entire test")" Variant="Variant.Outlined" Min="1" Class="text-align-right" HideSpinButtons="true"
                                         HelperText="Enter any positive whole number of minutes, such as 10, 30, or 120." @bind-Value="_minutes" Immediate="true" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@RulesText</MudText>
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="align-self-start" Disabled="@_isProcessing" StartIcon="@(_isProcessing ? null : Icons.Material.Outlined.Add)">
                            @if (_isProcessing) {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            }
                            Create lobby
                        </MudButton>
                    </MudStack>
                </form>
            </div>
        </MudItem>
        <MudItem xs="12" md="6">
            <div>
                <MudText Typo="Typo.overline" Class="section-label">Join a lobby</MudText>
                <form @onsubmit="JoinLobbyFromForm">
                    <MudStack Spacing="3" Class="mt-4">
                        <MudTextField T="string" Label="Lobby code" Variant="Variant.Outlined" MaxLength="10" @bind-Value="_joinCode" Immediate="true" />
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="align-self-start" Disabled="@_isProcessing" StartIcon="@(_isProcessing ? null : Icons.Material.Outlined.Login)">
                            @if (_isProcessing) {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            }
                            Join lobby
                        </MudButton>
                    </MudStack>
                </form>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-6 measure">A lobby holds 2 to 20 signed-in players. Only the host can start the match, and only when everyone is ready.</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-3 measure">If you lose your connection, open the lobby link again to rejoin. The match clock keeps running without you.</MudText>
            </div>
        </MudItem>
    </MudGrid>
} else {
    <MudPaper Elevation="0" Class="@AppTheme.Panel">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <div>
                <MudText Typo="Typo.overline" Color="Color.Secondary">Lobby code</MudText>
                <MudText Typo="Typo.h4" Class="code-text">@_view.Code</MudText>
            </div>
            <div class="timer" role="timer">@TimerText</div>
        </MudStack>
        <MudText Class="mt-3">@SettingsText</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">@BreakdownText</MudText>
        <MudTextField T="string" Label="Shareable lobby link" Variant="Variant.Outlined" ReadOnly="true" Value="@ShareLink" Class="mt-4"
                      Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.ContentCopy" OnAdornmentClick="CopyLink" AdornmentAriaLabel="Copy link" />
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" Class="mt-4">
            @if (IsWaiting) {
                <MudButton Variant="Variant.Outlined" Disabled="@_isProcessing" OnClick="ToggleReady" StartIcon="@(_view.Ready ? Icons.Material.Filled.Close : Icons.Material.Filled.Check)">@(_view.Ready ? "Not ready" : "I am ready")</MudButton>
            }
            @if (IsWaiting && IsHost) {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_isProcessing || !CanStart)" OnClick="StartMatch" StartIcon="@Icons.Material.Filled.PlayArrow">Start match</MudButton>
            }
            @if (_view.Status == "finished" && !_waitingForHost) {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_isProcessing" OnClick="PlayAgain" StartIcon="@Icons.Material.Filled.Replay">@(IsHost ? "New game · back to lobby" : "Back to lobby")</MudButton>
            }
            @if (_view.Status != "playing" && _view.Status != "cancelled") {
                <MudButton Variant="Variant.Outlined" Disabled="@_isProcessing" OnClick="LeaveLobby" StartIcon="@Icons.Material.Filled.Logout">@LeaveButtonText</MudButton>
            }
            @if (IsHost && _view.Status == "waiting") {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="@_isProcessing" OnClick="CancelLobby" StartIcon="@Icons.Material.Filled.Cancel">Cancel lobby</MudButton>
            }
        </MudStack>
        <MudStack Spacing="2" Class="mt-5">
            @foreach (var player in _view.Players) {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                    <MudText><strong>@player.Name</strong></MudText>
                    @if (player.Id == _view.Host) {
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">Host</MudChip>
                    }
                    @if (player.Id == _view.Me) {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">You</MudChip>
                    }
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@PlayerStatus(player)</MudText>
                </MudStack>
            }
        </MudStack>
    </MudPaper>
    <MudPaper Elevation="0" Class="@($"{AppTheme.Panel} mt-6")">
        <LobbyGameArea View="_view"
                       WaitingForHost="_waitingForHost"
                       SelectedChoice="_selectedChoice"
                       IsProcessing="_isProcessing"
                       OnChoiceSelected="SelectChoice"
                       OnSubmitAnswer="SubmitAnswer"
                       OnCloseLobby="CloseRoom" />
    </MudPaper>
}

@code {
    #region Properties
    [SupplyParameterFromQuery(Name = "code")] public string? CodeFromLink { get; set; }
    private const int _clockTickMilliseconds = 1000;
    private const int _safetyRefreshSeconds = 30;
    private readonly SemaphoreSlim _refreshLock = new(1, 1);
    private LobbyView? _view;
    private string _userId = "";
    private string _userName = "";
    private string _level = "Professional";
    private string _category = "All 4 Subjects (Final Mock Exam)";
    private string _mode = "test";
    private int _count = 30;
    private int _minutes = 3;
    private string _joinCode = "";
    private bool _isLoading = true;
    private bool _isProcessing;
    private bool _isDisposed;
    private bool _waitingForHost;
    private int? _selectedChoice;
    private string _questionKey = "";
    private DateTime? _refreshedForEnd;
    private int _secondsSinceRefresh;
    private IDisposable? _subscription;
    private System.Threading.Timer? _clock;
    private bool IsHost => _view != null && _view.Host == _view.Me;
    private bool IsWaiting => _view != null && _view.Status == "waiting";
    private bool CanStart => _view != null && _view.Players.Count >= 2 && _view.Players.All(p => p.Ready);
    private string ShareLink => _view == null ? "" : Navigation.BaseUri.TrimEnd('/') + "/Multiplayer?code=" + _view.Code;
    private string LeaveButtonText => _view != null && _view.Status == "finished" && IsHost ? "Close lobby & leave" : "Leave lobby";
    private string RulesText => _mode == "speed"
        ? "First correct answer received by the server wins the round. A wrong answer eliminates you for that round. Five seconds of review follow each round. Most rounds won wins the match; equal scores draw."
        : "Answer at your own pace before the shared timer ends. Most correct answers wins; equal scores draw. Answers are revealed only when the match ends.";
    #endregion

    #region Lifecycle
    protected override async Task OnInitializedAsync() {
        try {
            var user = await Users.Get();
            _userId = user.Id;
            _userName = user.Name;
            if (!string.IsNullOrWhiteSpace(CodeFromLink)) await RunAction(() => JoinLobbyByCode(CodeFromLink.Trim().ToUpperInvariant()));
        } finally {
            _isLoading = false;
        }
    }

    public void Dispose() {
        _isDisposed = true;
        StopRoomTracking();
    }
    #endregion

    #region Display text
    private string TimerText {
        get {
            if (_view == null || _view.Status != "playing") return _view?.Status.ToUpperInvariant() ?? "";
            var end = _view.NextRoundAt ?? _view.Deadline;
            var seconds = end == null ? 0 : Math.Max(0, (int)Math.Ceiling((end.Value - DateTime.UtcNow).TotalSeconds));
            var label = _view.NextRoundAt != null ? "Next round in " : "Time left ";
            return $"{label}{seconds / 60}:{seconds % 60:00}";
        }
    }

    private string SettingsText {
        get {
            var speed = _view!.Mode == "speed";
            return $"Game {_view.Game} · {_view.Level} · {_view.Category} · {_view.Count} questions · {(speed ? "Speed rounds" : "Timed test")} · {_view.Minutes} min {(speed ? "per question" : "total")}";
        }
    }

    private string BreakdownText => string.Join(" · ", _view!.Breakdown.Select(x => $"{x.Category}: {x.Count}"));

    private string PlayerStatus(LobbyPlayerView player) {
        if (IsWaiting) return player.Ready ? "Ready" : "Not ready";
        return $"{player.Answered} answered{(player.Score == null ? "" : $" · {player.Score} points")}";
    }

    private static string ModeLabel(string mode) => mode == "speed" ? "Speed rounds · first correct wins" : "Timed test · most correct wins";

    private List<string> GetCategories() => [
        "All 4 Subjects (Final Mock Exam)",
        "Numerical Ability",
        "Verbal Ability",
        _level == "Professional" ? "Analytical Ability" : "Clerical Ability",
        "General Information"
    ];
    #endregion

    #region Setup
    private void ChangeLevel(string level) {
        _level = level;
        _category = GetCategories()[0];
    }

    private void ShowError(string message) {
        Extension.ShowAlert(message, Variant.Filled, Snackbar, Severity.Error);
    }

    private async Task RunAction(Func<Task> work) {
        if (_isProcessing) return;
        _isProcessing = true;
        try { await work(); }
        catch (Exception ex) { ShowError(ex.Message); }
        finally { _isProcessing = false; }
    }
    #endregion

    #region Opening and closing a lobby
    private Task CreateNewLobby() => RunAction(async () => {
        if (_count < 30 || _count > 180) { Extension.ShowAlert("Choose 30 to 180 questions.", Variant.Filled, Snackbar, Severity.Warning); return; }
        if (_minutes < 1) { Extension.ShowAlert("Enter a positive whole number of minutes.", Variant.Filled, Snackbar, Severity.Warning); return; }
        var created = await Lobbies.Create(_userId, _userName, new CreateLobby(_category, _level, _mode, _count, _minutes));
        if (!created.IsSuccess) { ShowError(created.Error); return; }
        await OpenRoom(await Lobbies.Read(created.Value!, _userId, _userName));
    });

    private Task JoinLobbyFromForm() => RunAction(async () => {
        var code = (_joinCode ?? "").Trim().ToUpperInvariant();
        if (code.Length != 10 || !code.All(Uri.IsHexDigit)) { Extension.ShowAlert("Enter the ten-character lobby code (letters A-F and numbers).", Variant.Filled, Snackbar, Severity.Warning); return; }
        await JoinLobbyByCode(code);
    });

    private async Task JoinLobbyByCode(string code) {
        await OpenRoom(await Lobbies.Join(code, _userId, _userName));
    }

    private async Task OpenRoom(ServiceResult<LobbyView> result) {
        if (!result.IsSuccess) { ShowError(ErrorText(result)); return; }
        StopRoomTracking();
        _view = null;
        _waitingForHost = false;
        _questionKey = "";
        ApplyView(result.Value!);
        _subscription = Notifier.Subscribe(result.Value!.Code, OnLobbyChanged);
        StartClock();
        await JS.InvokeVoidAsync("history.replaceState", null, "", "/Multiplayer?code=" + result.Value.Code);
        await RefreshView();
    }

    private async Task CloseRoom() {
        StopRoomTracking();
        _view = null;
        _waitingForHost = false;
        _selectedChoice = null;
        await JS.InvokeVoidAsync("history.replaceState", null, "", "/Multiplayer");
    }

    private void StartClock() {
        _clock = new System.Threading.Timer(_ => { _ = InvokeAsync(ClockTick); }, null, _clockTickMilliseconds, _clockTickMilliseconds);
    }

    private void StopRoomTracking() {
        _subscription?.Dispose();
        _subscription = null;
        _clock?.Dispose();
        _clock = null;
    }
    #endregion

    #region Keeping the lobby up to date
    private Task OnLobbyChanged() => InvokeAsync(async () => {
        await RefreshView();
        if (!_isDisposed) StateHasChanged();
    });

    private async Task ClockTick() {
        if (_isDisposed || _view == null) return;
        if (_view.Status == "cancelled") { StopRoomTracking(); StateHasChanged(); return; }
        _secondsSinceRefresh++;
        var end = _view.Status == "playing" ? (_view.NextRoundAt ?? _view.Deadline) : null;
        var deadlinePassed = end != null && DateTime.UtcNow >= end && _refreshedForEnd != end;
        if (deadlinePassed) _refreshedForEnd = end;
        if (deadlinePassed || _secondsSinceRefresh >= _safetyRefreshSeconds) await RefreshView();
        if (!_isDisposed) StateHasChanged();
    }

    private async Task RefreshView() {
        if (_view == null || _isDisposed) return;
        var code = _view.Code;
        await _refreshLock.WaitAsync();
        try {
            var result = await Lobbies.Read(code, _userId, _userName);
            if (_view == null || _view.Code != code) return;
            if (result.IsSuccess) ApplyView(result.Value!);
            else ShowError(ErrorText(result));
        } catch (Exception ex) {
            ShowError("Connection interrupted. " + ex.Message);
        } finally {
            _refreshLock.Release();
        }
    }

    private void ApplyView(LobbyView view) {
        if (_view != null && _view.Code == view.Code && view.ServerTime < _view.ServerTime) return;
        _view = view;
        _secondsSinceRefresh = 0;
        if (view.Status != "finished") _waitingForHost = false;
        var key = $"{view.Game}|{view.Status}|{view.Index}|{view.Answered}|{view.NextRoundAt}";
        if (key == _questionKey) return;
        _questionKey = key;
        _selectedChoice = null;
    }

    private static string ErrorText(ServiceResult result) {
        if (result.Error.Length > 0) return result.Error;
        return result.Status == 403 ? "Only the host can do that." : "Request failed. Please retry.";
    }
    #endregion

    #region Player actions
    private Task ToggleReady() => RunAction(async () => ApplyActionResult(await Lobbies.SetReady(_view!.Code, _userId, _userName, !_view.Ready)));

    private Task StartMatch() => RunAction(async () => ApplyActionResult(await Lobbies.Start(_view!.Code, _userId, _userName)));

    private Task CancelLobby() => RunAction(async () => {
        var confirmed = await DialogService.ShowMessageBox("Close this lobby?", "Close this lobby for everyone? Players will be returned to the main screen.", yesText: "Close lobby", cancelText: "Keep it");
        if (confirmed != true) return;
        var result = await Lobbies.Cancel(_view!.Code, _userId, _userName);
        if (result.IsSuccess && result.Value!.Status == "cancelled") await CloseRoom();
        else ApplyActionResult(result);
    });

    private Task LeaveLobby() => RunAction(async () => {
        if (_view!.Status == "finished" && IsHost) {
            var confirmed = await DialogService.ShowMessageBox("Leave and close the lobby?", "Leave and close the lobby? All players will be disconnected.", yesText: "Leave and close", cancelText: "Stay");
            if (confirmed != true) return;
        }
        var result = await Lobbies.Leave(_view.Code, _userId, _userName);
        if (result.IsSuccess) await CloseRoom();
        else ApplyActionResult(result);
    });

    private Task PlayAgain() => RunAction(async () => {
        if (!IsHost) { _waitingForHost = true; return; }
        ApplyActionResult(await Lobbies.Replay(_view!.Code, _userId, _userName, _view.Game));
    });

    private void SelectChoice(int choice) {
        _selectedChoice = choice;
    }

    private Task SubmitAnswer() => RunAction(async () => {
        if (_selectedChoice == null) return;
        var answer = new LobbyAction(_view!.Index, _selectedChoice.Value, _view.Game);
        var result = await Lobbies.Answer(_view.Code, _userId, _userName, answer);
        ApplyActionResult(result);
        if (!result.IsSuccess) await RefreshView();
    });

    private async Task CopyLink() {
        try {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", ShareLink);
            Extension.ShowAlert("Lobby link copied.", Variant.Filled, Snackbar, Severity.Success);
        } catch (JSException) {
            Extension.ShowAlert("Select and copy the lobby link above.", Variant.Filled, Snackbar, Severity.Info);
        }
    }

    private void ApplyActionResult(ServiceResult<LobbyView> result) {
        if (result.IsSuccess) ApplyView(result.Value!);
        else ShowError(ErrorText(result));
    }
    #endregion
}
