@page "/Administration"
@attribute [Authorize(Policy = "Admin")]
@inject AccountService Accounts
@inject BankService Bank
@inject CurrentUserAccessor Users
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Administration · Husay</PageTitle>

<div class="page-head">
    <MudText Typo="Typo.overline" Color="Color.Primary">Administration</MudText>
    <MudText Typo="Typo.h3" Class="mt-1">Accounts and questions</MudText>
    <MudText Color="Color.Secondary" Class="mt-3 measure">Manage who can sign in and what role they have, and add single questions to the shared bank. To import many questions at once, use the Question bank section on the Practice page.</MudText>
</div>

@if (_user == null) {
    <MudProgressLinear Indeterminate="true" Class="@AppTheme.SectionGap" />
} else if (!_user.IsAdmin) {
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="@AppTheme.SectionGap">Administrator access is required.</MudAlert>
} else {
    @if (_user.IsSuperAdmin) {
        <section class="mb-10">
            <MudText Typo="Typo.overline" Class="section-label">User accounts</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="measure">Accounts appear here after people register. Admins can add and import questions. Users can practice and save their own progress.</MudText>
            <MudTextField T="string" Placeholder="Search by username…" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          @bind-Value="_search" Immediate="true" Clearable="true" Class="mt-4" aria-label="Search users by username" />
            @if (string.IsNullOrWhiteSpace(_search)) {
                <MudText Color="Color.Secondary" Class="mt-4">Search a username to find an account.</MudText>
            } else {
                <MudTable T="AccountSummary" Items="MatchingUsers" Dense="true" Hover="true" Outlined="true" Elevation="0" Class="mt-4">
                    <HeaderContent>
                        <MudTh>Username</MudTh>
                        <MudTh>Role</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Username"><strong>@context.Username</strong></MudTd>
                        <MudTd DataLabel="Role">@(context.Role == "SuperAdmin" ? "Super Admin" : context.Role)</MudTd>
                        <MudTd>
                            @if (context.Role != "SuperAdmin") {
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Edit" OnClick="() => EditUser(context)" aria-label="@("Update " + context.Username)">Update</MudButton>
                            }
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText>No users match your search.</MudText>
                    </NoRecordsContent>
                </MudTable>
            }
        </section>
    }

    <section class="mb-10">
        <MudText Typo="Typo.overline" Class="section-label">Add a question</MudText>
        <MudForm @key="_questionFormVersion" @ref="_questionForm" Class="mt-4">
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudSelect T="string" Label="Subject" Variant="Variant.Outlined" @bind-Value="_category">
                        <MudSelectItem T="string" Value="@("Numerical Ability")" />
                        <MudSelectItem T="string" Value="@("Verbal Ability")" />
                        <MudSelectItem T="string" Value="@("Analytical Ability")" />
                        <MudSelectItem T="string" Value="@("Clerical Ability")" />
                        <MudSelectItem T="string" Value="@("General Information")" />
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudSelect T="string" Label="Exam level" Variant="Variant.Outlined" @bind-Value="_level">
                        <MudSelectItem T="string" Value="@("Professional")" />
                        <MudSelectItem T="string" Value="@("Subprofessional")" />
                        <MudSelectItem T="string" Value="@("Both")" />
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudSelect T="string" Label="Difficulty" Variant="Variant.Outlined" @bind-Value="_difficulty">
                        <MudSelectItem T="string" Value="@("Easy")" />
                        <MudSelectItem T="string" Value="@("Moderate")" />
                        <MudSelectItem T="string" Value="@("Hard")" />
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" Label="Question" Variant="Variant.Outlined" Lines="3" MaxLength="3000" Required="true" RequiredError="Enter the question." @bind-Value="_prompt" Immediate="true" />
                </MudItem>
                @for (var i = 0; i < _options.Length; i++) {
                    var optionIndex = i;
                    <MudItem xs="12" md="6">
                        <MudTextField T="string" Label="@($"Option {"ABCD"[optionIndex]}")" Variant="Variant.Outlined" Required="true" RequiredError="Enter this option." @bind-Value="_options[optionIndex]" Immediate="true" />
                    </MudItem>
                }
                <MudItem xs="12" md="6">
                    <MudSelect T="int" Label="Correct answer" Variant="Variant.Outlined" @bind-Value="_answer">
                        <MudSelectItem T="int" Value="0">A</MudSelectItem>
                        <MudSelectItem T="int" Value="1">B</MudSelectItem>
                        <MudSelectItem T="int" Value="2">C</MudSelectItem>
                        <MudSelectItem T="int" Value="3">D</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" Label="Why is this correct?" Variant="Variant.Outlined" Lines="2" Required="true" RequiredError="Explain the answer." @bind-Value="_explanation" Immediate="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField T="string" Label="Solving steps" Variant="Variant.Outlined" Lines="3" HelperText="One per line. Required for numerical questions." @bind-Value="_steps" Immediate="true" />
                </MudItem>
            </MudGrid>
        </MudForm>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" Disabled="@_isSubmitting" OnClick="AddQuestion" StartIcon="@(_isSubmitting ? null : Icons.Material.Filled.Add)">
            @if (_isSubmitting) {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Add to question bank
        </MudButton>
    </section>
}

@code {
    #region Properties
    private CurrentUser? _user;
    private MudForm _questionForm = default!;
    private int _questionFormVersion;
    private List<AccountSummary> _profiles = [];
    private string _search = "";
    private string _category = "Numerical Ability";
    private string _level = "Professional";
    private string _difficulty = "Easy";
    private string _prompt = "";
    private string[] _options = ["", "", "", ""];
    private int _answer;
    private string _explanation = "";
    private string _steps = "";
    private bool _isSubmitting;
    private List<AccountSummary> MatchingUsers => _profiles.Where(p => p.Username.Contains((_search ?? "").Trim(), StringComparison.OrdinalIgnoreCase)).ToList();
    #endregion

    #region Lifecycle
    protected override async Task OnInitializedAsync() {
        _user = await Users.Get();
        if (!_user.IsSuperAdmin) return;
        try {
            var result = await Accounts.GetUsers(_user.Id);
            if (result.IsSuccess) _profiles = result.Value!;
            else Extension.ShowAlert(result.Error.Length > 0 ? result.Error : "You do not have permission to perform this action.", Variant.Filled, Snackbar, Severity.Error);
        } catch (Exception ex) {
            Extension.ShowAlert(ex.Message, Variant.Filled, Snackbar, Severity.Error);
        }
    }
    #endregion

    #region User roles
    private async Task EditUser(AccountSummary profile) {
        var parameters = new DialogParameters<EditUserDialog> {
            { x => x.Account, profile }
        };
        var dialog = await DialogService.ShowAsync<EditUserDialog>("Update " + profile.Username, parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result == null || result.Canceled || result.Data is not EditUserResult saved) return;
        var position = _profiles.FindIndex(p => p.Id == saved.Account.Id);
        if (position >= 0) _profiles[position] = saved.Account;
        _search = saved.Account.Username;
        var passwordNote = saved.PasswordChanged ? " They must change their temporary password at next sign-in." : " Existing password kept.";
        Extension.ShowAlert("Saved changes for " + saved.Account.Username + "." + passwordNote, Variant.Filled, Snackbar, Severity.Success);
    }
    #endregion

    #region Add a question
    private async Task AddQuestion() {
        if (_isSubmitting) return;
        await _questionForm.Validate();
        if (!_questionForm.IsValid) return;
        _isSubmitting = true;
        try {
            var steps = _steps.Split('\n').Select(s => s.Trim()).Where(s => s.Length > 0).ToArray();
            var entry = new ImportEntry(_category, _level, _difficulty, _prompt, _options.ToArray(), _answer, _explanation, steps);
            var result = await Bank.AddQuestion(_user!.Id, entry);
            if (!result.IsSuccess) {
                Extension.ShowAlert(result.Error.Length > 0 ? result.Error : "You do not have permission to perform this action.", Variant.Filled, Snackbar, Severity.Error);
                return;
            }
            if (result.Value!.Added > 0) {
                Extension.ShowAlert("Question added to the shared bank.", Variant.Filled, Snackbar, Severity.Success);
                ClearQuestionForm();
            } else {
                Extension.ShowAlert("This question is already in your bank.", Variant.Filled, Snackbar, Severity.Info);
            }
        } catch (Exception ex) {
            Extension.ShowAlert(ex.Message, Variant.Filled, Snackbar, Severity.Error);
        } finally {
            _isSubmitting = false;
        }
    }

    private void ClearQuestionForm() {
        _prompt = "";
        _options = ["", "", "", ""];
        _answer = 0;
        _explanation = "";
        _steps = "";
        _questionFormVersion++;
    }
    #endregion
}
