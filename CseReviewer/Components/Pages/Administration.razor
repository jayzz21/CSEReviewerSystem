@page "/Administration"
@attribute [Authorize(Policy = "Admin")]
@inject AccountService Accounts
@inject BankService Bank
@inject CurrentUserAccessor Users

<PageTitle>Administration · Husay</PageTitle>

<h1 class="text-3xl font-bold mt-6">Administration</h1>
<p id="adm-message" role="status" class="mt-4">@_message</p>

@if (_user?.IsAdmin == true) {
    @if (_user.IsSuperAdmin) {
        <section id="adm-users-section" class="panel p-6 mt-6">
            <h2 class="text-xl font-bold">User roles</h2>
            <p class="mt-3 text-sm">Accounts appear after registration. Admins can add and import questions. Users can study and save their own progress.</p>
            <div id="adm-users" class="mt-4 space-y-3">
                <input type="search" placeholder="Search by username…" aria-label="Search users by username" disabled="@_isSaving" value="@_search" @oninput="ChangeSearch">
                <div class="space-y-3 mt-4" aria-live="polite">
                    @if (string.IsNullOrWhiteSpace(_search)) {
                        <p>Search a username to find an account.</p>
                    } else if (MatchingUsers.Count == 0) {
                        <p>No users match your search.</p>
                    } else {
                        @foreach (var profile in MatchingUsers) {
                            <div class="flex flex-wrap items-center justify-between gap-3 border border-slate-200 rounded-xl p-4">
                                <strong>@profile.Username</strong>
                                <span class="text-sm text-slate-500">@(profile.Role == "SuperAdmin" ? "Super Admin" : profile.Role)</span>
                                @if (profile.Role != "SuperAdmin") {
                                    <button type="button" class="secondary" disabled="@_isSaving" aria-label="@("Update " + profile.Username)" @onclick="() => StartEdit(profile)">Update</button>
                                }
                            </div>
                        }
                    }
                </div>
                @if (_editTarget != null) {
                    <form class="panel p-4 space-y-4 mt-4" @onsubmit="SaveUser">
                        <h3 class="text-lg font-bold">Update @_editTarget.Username</h3>
                        <label class="block">Username
                            <input required minlength="3" maxlength="30" pattern="[a-zA-Z0-9_]{3,30}" autocomplete="off" disabled="@_isSaving" @bind="_editUsername" @bind:event="oninput">
                        </label>
                        <label class="block">Role
                            <select disabled="@_isSaving" @bind="_editRole">
                                <option>User</option>
                                <option>Admin</option>
                            </select>
                        </label>
                        <label class="block">New temporary password (optional)
                            <input type="password" minlength="12" maxlength="128" autocomplete="new-password" placeholder="Leave blank to keep current password" disabled="@_isSaving" @bind="_editPassword" @bind:event="oninput">
                        </label>
                        <p class="text-sm text-slate-500">A new password requires the user to change it at their next sign-in.</p>
                        <div class="flex flex-wrap gap-3">
                            <button type="submit" class="primary" disabled="@_isSaving">Save changes</button>
                            <button type="button" class="secondary" disabled="@_isSaving" @onclick="CloseEditor">Cancel</button>
                        </div>
                        <p role="status">@_editStatus</p>
                    </form>
                }
            </div>
        </section>
    }

    <section class="panel p-6 mt-6">
        <h2 class="text-xl font-bold">Add a question</h2>
        <form class="space-y-4 mt-4" @onsubmit="AddQuestion">
            <div class="grid md:grid-cols-2 gap-4">
                <label>Subject
                    <select @bind="_category">
                        <option>Numerical Ability</option>
                        <option>Verbal Ability</option>
                        <option>Analytical Ability</option>
                        <option>Clerical Ability</option>
                        <option>General Information</option>
                    </select>
                </label>
                <label>Exam level
                    <select @bind="_level">
                        <option>Professional</option>
                        <option>Subprofessional</option>
                        <option>Both</option>
                    </select>
                </label>
            </div>
            <label class="block">Difficulty
                <select @bind="_difficulty">
                    <option>Easy</option>
                    <option>Moderate</option>
                    <option>Hard</option>
                </select>
            </label>
            <label class="block">Question
                <textarea required maxlength="3000" @bind="_prompt" @bind:event="oninput"></textarea>
            </label>
            <div class="grid md:grid-cols-2 gap-4">
                @for (var i = 0; i < _options.Length; i++) {
                    var optionIndex = i;
                    <label>Option @("ABCD"[optionIndex])
                        <input required @bind="_options[optionIndex]" @bind:event="oninput">
                    </label>
                }
            </div>
            <label class="block">Correct answer
                <select @bind="_answer">
                    <option value="0">A</option>
                    <option value="1">B</option>
                    <option value="2">C</option>
                    <option value="3">D</option>
                </select>
            </label>
            <label class="block">Why is this correct?
                <textarea required @bind="_explanation" @bind:event="oninput"></textarea>
            </label>
            <label class="block">Solving steps (one per line; required for numerical questions)
                <textarea @bind="_steps" @bind:event="oninput"></textarea>
            </label>
            <button class="primary" type="submit" disabled="@_isSubmitting">Add to question bank</button>
        </form>
    </section>
}

@code {
    #region Properties
    private CurrentUser? _user;
    private List<AccountSummary> _profiles = [];
    private AccountSummary? _editTarget;
    private string _message = "";
    private string _search = "";
    private string _editUsername = "";
    private string _editRole = "User";
    private string _editPassword = "";
    private string _editStatus = "";
    private string _category = "Numerical Ability";
    private string _level = "Professional";
    private string _difficulty = "Easy";
    private string _prompt = "";
    private string[] _options = ["", "", "", ""];
    private int _answer;
    private string _explanation = "";
    private string _steps = "";
    private bool _isSaving;
    private bool _isSubmitting;
    private List<AccountSummary> MatchingUsers => _profiles.Where(p => p.Username.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();
    #endregion

    #region Lifecycle
    protected override async Task OnInitializedAsync() {
        _user = await Users.Get();
        if (!_user.IsAdmin) { _message = "Administrator access is required."; return; }
        if (!_user.IsSuperAdmin) return;
        try {
            var result = await Accounts.GetUsers(_user.Id);
            if (result.IsSuccess) _profiles = result.Value!;
            else _message = result.Error.Length > 0 ? result.Error : "You do not have permission to perform this action.";
        } catch (Exception ex) {
            _message = ex.Message;
        }
    }
    #endregion

    #region User roles
    private void ChangeSearch(ChangeEventArgs e) {
        _search = e.Value?.ToString() ?? "";
        if (!_isSaving) CloseEditor();
    }

    private void StartEdit(AccountSummary profile) {
        _editTarget = profile;
        _editUsername = profile.Username;
        _editRole = profile.Role;
        _editPassword = "";
        _editStatus = "";
    }

    private void CloseEditor() {
        _editTarget = null;
        _editPassword = "";
        _editStatus = "";
    }

    private async Task SaveUser() {
        if (_editTarget == null || _isSaving) return;
        _isSaving = true;
        _editStatus = "Saving…";
        try {
            var target = _editTarget;
            var result = await Accounts.UpdateAccount(_user!.Id, target.Id, new UpdateAccount(_editUsername, _editRole, _editPassword));
            if (!result.IsSuccess) { _editStatus = result.Error.Length > 0 ? result.Error : "You do not have permission to perform this action."; return; }
            var saved = result.Value!;
            var position = _profiles.FindIndex(p => p.Id == saved.Id);
            if (position >= 0) _profiles[position] = saved;
            _message = "Saved changes for " + saved.Username + "." + (_editPassword.Length > 0 ? " They must change their temporary password at next sign-in." : " Existing password kept.");
            _search = saved.Username;
            CloseEditor();
        } catch (Exception ex) {
            _editStatus = ex.Message;
        } finally {
            _isSaving = false;
        }
    }
    #endregion

    #region Add a question
    private async Task AddQuestion() {
        if (_isSubmitting) return;
        _isSubmitting = true;
        try {
            var steps = _steps.Split('\n').Select(s => s.Trim()).Where(s => s.Length > 0).ToArray();
            var entry = new ImportEntry(_category, _level, _difficulty, _prompt, _options.ToArray(), _answer, _explanation, steps);
            var result = await Bank.AddQuestion(_user!.Id, entry);
            if (!result.IsSuccess) { _message = result.Error.Length > 0 ? result.Error : "You do not have permission to perform this action."; return; }
            _message = result.Value!.Added > 0 ? "Question added to the shared bank." : "This question is already in your bank.";
            if (result.Value.Added > 0) ClearQuestionForm();
        } catch (Exception ex) {
            _message = ex.Message;
        } finally {
            _isSubmitting = false;
        }
    }

    private void ClearQuestionForm() {
        _prompt = "";
        _options = ["", "", "", ""];
        _answer = 0;
        _explanation = "";
        _steps = "";
    }
    #endregion
}
