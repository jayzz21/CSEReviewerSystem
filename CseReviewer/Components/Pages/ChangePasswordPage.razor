@page "/Change-Password"
@attribute [Authorize]
@layout AuthLayout
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>Set your new password · Husay</PageTitle>

<MudText Typo="Typo.h5">Set your new password</MudText>
<MudText Color="Color.Secondary" Class="mt-2">Replace your temporary password before continuing.</MudText>
@if (_error.Length > 0) {
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4">@_error</MudAlert>
}
<form @onsubmit="ChangePassword">
    <MudStack Spacing="3" Class="mt-6">
        <MudTextField T="string" Label="Current password" Variant="Variant.Outlined" InputType="@PasswordInputType" @bind-Value="_currentPassword" Immediate="true" MaxLength="128" Disabled="@_isSubmitting"
                      Adornment="Adornment.End" AdornmentIcon="@PasswordIcon" OnAdornmentClick="TogglePasswordVisibility" AdornmentAriaLabel="Show or hide passwords"
                      UserAttributes="@(new Dictionary<string, object> { { "autocomplete", "current-password" } })" />
        <MudTextField T="string" Label="New password" Variant="Variant.Outlined" InputType="@PasswordInputType" @bind-Value="_newPassword" Immediate="true" MaxLength="128" Disabled="@_isSubmitting"
                      HelperText="At least 12 characters."
                      UserAttributes="@(new Dictionary<string, object> { { "autocomplete", "new-password" } })" />
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Disabled="@_isSubmitting"
                   StartIcon="@(_isSubmitting ? null : Icons.Material.Filled.LockReset)">
            @if (_isSubmitting) {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Update password
        </MudButton>
    </MudStack>
</form>
<MudLink Href="/Logout" Class="mt-6 d-block">Sign out</MudLink>

@code {
    #region Properties
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
    private string _currentPassword = "";
    private string _newPassword = "";
    private string _error = "";
    private bool _showPassword;
    private bool _isSubmitting;
    private InputType PasswordInputType => _showPassword ? InputType.Text : InputType.Password;
    private string PasswordIcon => _showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility;
    private string SafeReturnUrl {
        get {
            var isLocalPath = !string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//") && !ReturnUrl.StartsWith("/\\");
            return isLocalPath ? ReturnUrl! : "/";
        }
    }
    #endregion

    #region Methods
    private void TogglePasswordVisibility() {
        _showPassword = !_showPassword;
    }

    private string ErrorText(AuthResponse response) {
        if (response.Status == 429) return "Too many attempts. Wait one minute and try again.";
        return response.Error.Length > 0 ? response.Error : "Request failed. Please retry.";
    }

    private async Task ChangePassword() {
        if (_isSubmitting) return;
        _error = "";
        if (string.IsNullOrEmpty(_currentPassword)) {
            _error = "Enter your current password.";
            return;
        }
        if (_newPassword.Length < 12 || _newPassword.Length > 128) {
            _error = "Use a new password of 12-128 characters.";
            return;
        }
        _isSubmitting = true;
        try {
            var response = await JS.InvokeAsync<AuthResponse>("husayAuth.post", "change-password", new { currentPassword = _currentPassword, newPassword = _newPassword });
            if (response.Status != 200) { _error = ErrorText(response); return; }
            _currentPassword = "";
            _newPassword = "";
            Navigation.NavigateTo(SafeReturnUrl, forceLoad: true);
        } catch (Exception ex) {
            Extension.ShowAlert(ex.Message, Variant.Filled, Snackbar, Severity.Error);
        } finally {
            _isSubmitting = false;
        }
    }
    #endregion
}
