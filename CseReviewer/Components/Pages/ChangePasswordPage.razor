@page "/Change-Password"
@attribute [Authorize]
@layout AuthLayout

<PageTitle>Set your new password · Husay</PageTitle>

<h2 id="auth-title" class="text-2xl font-bold">Set your new password</h2>
<p id="auth-message" class="mt-4 text-sm" role="status" aria-live="polite">@Message</p>
<form id="change-form" method="post" action="/Account/ChangePassword" class="space-y-4 mt-6">
    <AntiforgeryToken />
    <input type="hidden" name="returnUrl" value="@SafeReturnUrl">
    <p>Replace your temporary password before continuing.</p>
    <PasswordField Id="current-password" Name="currentPassword" Label="Current password" />
    <PasswordField Id="new-password" Name="newPassword" Label="New password" Autocomplete="new-password" MinLength="12" />
    <button class="primary" type="submit">Update password</button>
</form>
<div class="space-y-4 mt-6">
    <a href="/Logout" class="text-teal-800 underline">Sign out</a>
</div>

@code {
    #region Properties
    [SupplyParameterFromQuery(Name = "error")] public string? ErrorCode { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
    private string SafeReturnUrl {
        get {
            var isLocalPath = !string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//") && !ReturnUrl.StartsWith("/\\");
            return isLocalPath ? ReturnUrl! : "";
        }
    }
    private string Message => ErrorCode switch {
        "wrong" => "Current password is incorrect.",
        "invalid" => "Use a new password of 12–128 characters.",
        "toomany" => "Too many attempts. Wait one minute and try again.",
        _ => ""
    };
    #endregion
}
