@page "/Practice/{SetId:guid}"
@attribute [Authorize]
@inject PracticeService Practice
@inject CurrentUserAccessor Users
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>@(_set?.Title ?? "Practice") · Husay</PageTitle>

<NavigationLock OnBeforeInternalNavigation="ConfirmLeaving" ConfirmExternalNavigation="@HasUnfinishedPractice" />

@if (_isLoading) {
    <MudProgressLinear Indeterminate="true" />
} else if (_set == null) {
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">Practice set not found.</MudAlert>
    <MudButton Href="/" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowBack" Class="mt-4">Back to create</MudButton>
} else {
    <MudButton Href="/" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowBack" Class="mb-4">Back to create</MudButton>
    <MudText Typo="Typo.overline" Color="Color.Primary">@_set.Level · @_set.Source · @_set.Difficulty</MudText>
    <MudText Typo="Typo.h4" Class="mt-1">@_set.Title</MudText>

    <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mt-6">
        <MudText Typo="Typo.body2" Color="Color.Secondary">@(_showSummary ? "Practice complete" : $"Question {_index + 1} of {_set.Questions.Count}")</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@CorrectCount correct · @_results.Count answered</MudText>
    </MudStack>
    <MudProgressLinear Value="@ProgressPercent" Color="Color.Primary" Size="Size.Medium" Rounded="true" Class="mt-2" />

    <MudPaper Class="@($"{AppTheme.LargeCardPadding} {AppTheme.SectionGap}")">
        @if (_showSummary) {
            <MudText Typo="Typo.overline" Color="Color.Primary">One step closer</MudText>
            <MudText Typo="Typo.h4" Class="mt-2">You showed up. That matters.</MudText>
            <MudText Typo="Typo.h2" Color="Color.Primary" Class="mt-6">@CorrectCount<MudText Typo="Typo.h5" Color="Color.Secondary" Inline="true"> / @_results.Count</MudText></MudText>
            <MudText Color="Color.Secondary" Class="mt-2">@ScorePercent% on this practice set. Review your answers below, then start a newly selected set.</MudText>
            <MudExpansionPanels Class="mt-6" Elevation="0" Outlined="true">
                @for (var i = 0; i < _set.Questions.Count; i++) {
                    var question = _set.Questions[i];
                    var result = _results[i];
                    <MudExpansionPanel>
                        <TitleContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@(result.Correct ? Icons.Material.Filled.CheckCircle : Icons.Material.Outlined.Circle)" Color="@(result.Correct ? Color.Success : Color.Default)" />
                                <MudText>@question.Prompt</MudText>
                            </MudStack>
                        </TitleContent>
                        <ChildContent>
                            <MudText>Correct answer: @question.Options[result.Answer]</MudText>
                            <MudText Color="Color.Secondary" Class="mt-2">@result.Explanation</MudText>
                            @foreach (var step in result.Steps) {
                                <MudText Typo="Typo.body2" Class="mt-2">@step</MudText>
                            }
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-6" Disabled="@_isProcessing" OnClick="StartNextSet" EndIcon="@(_isProcessing ? null : Icons.Material.Filled.ArrowForward)">
                @if (_isProcessing) {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Start next set
            </MudButton>
        } else {
            var current = _set.Questions[_index];
            <MudText Typo="Typo.overline" Color="Color.Primary">@_set.Category</MudText>
            <MudText Typo="Typo.h6" Class="mt-2">@current.Prompt</MudText>
            <MudStack Spacing="3" Class="mt-5">
                @for (var i = 0; i < current.Options.Length; i++) {
                    var choice = i;
                    <MudButton Variant="@OptionVariant(choice)" Color="@OptionColor(choice)" FullWidth="true" aria-pressed="@(_selectedChoice == choice ? "true" : "false")"
                               Style="@AppTheme.ChoiceButtonStyle" OnClick="() => SelectChoice(choice)">
                        <MudAvatar Size="Size.Small" Variant="Variant.Outlined" Class="mr-3">@("ABCD"[choice])</MudAvatar>
                        @current.Options[choice]
                    </MudButton>
                }
            </MudStack>
            @if (_feedback == null) {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-6" Disabled="@(_selectedChoice == null || _isProcessing)" OnClick="CheckAnswer"
                           EndIcon="@(_isProcessing ? null : Icons.Material.Filled.ArrowForward)">
                    @if (_isProcessing) {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    Check answer
                </MudButton>
            } else {
                <MudAlert Severity="@(_feedback.Correct ? Severity.Success : Severity.Info)" Variant="Variant.Outlined" Class="mt-6" NoIcon="false">
                    <MudText Typo="Typo.subtitle1">@(_feedback.Correct ? "Correct. Nicely done!" : "Keep going, this is how you learn.")</MudText>
                    <MudText Typo="Typo.subtitle2" Class="mt-2">Correct answer: @("ABCD"[_feedback.Answer]). @current.Options[_feedback.Answer]</MudText>
                    <MudText Typo="Typo.body2" Class="mt-2">@_feedback.Explanation</MudText>
                    @if (_feedback.Steps.Length > 0) {
                        <MudText Typo="Typo.subtitle2" Class="mt-3">Step-by-step solution</MudText>
                        <ol style="padding-left:20px;margin:4px 0 0 0;">
                            @foreach (var step in _feedback.Steps) {
                                <li><MudText Typo="Typo.body2" Inline="true">@step</MudText></li>
                            }
                        </ol>
                    }
                </MudAlert>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" OnClick="NextQuestion" EndIcon="@Icons.Material.Filled.ArrowForward">
                    @(_index + 1 == _set.Questions.Count ? "See my results" : "Next question")
                </MudButton>
            }
        }
    </MudPaper>
}

@code {
    #region Properties
    [Parameter] public Guid SetId { get; set; }
    private StudySetDetail? _set;
    private AnswerFeedback? _feedback;
    private List<AnswerFeedback> _results = [];
    private CurrentUser? _user;
    private Guid _loadedSetId;
    private string _pendingUri = "/";
    private int _index;
    private int? _selectedChoice;
    private bool _isLoading = true;
    private bool _isProcessing;
    private bool _showSummary;
    private bool _allowLeave;
    private bool HasUnfinishedPractice => _set != null && _results.Count < _set.Questions.Count;
    private int CorrectCount => _results.Count(r => r.Correct);
    private int ScorePercent => _results.Count == 0 ? 0 : (int)Math.Round(CorrectCount * 100.0 / _results.Count, MidpointRounding.AwayFromZero);
    private double ProgressPercent => _set == null || _set.Questions.Count == 0 ? 0 : _results.Count * 100.0 / _set.Questions.Count;
    #endregion

    #region Lifecycle
    protected override async Task OnInitializedAsync() {
        _user = await Users.Get();
    }

    protected override async Task OnParametersSetAsync() {
        if (_loadedSetId == SetId) return;
        _loadedSetId = SetId;
        await LoadSet();
    }
    #endregion

    #region Methods
    private async Task LoadSet() {
        _isLoading = true;
        try {
            var result = await Practice.GetSet(_user!.Id, SetId);
            if (!result.IsSuccess) { _set = null; return; }
            _set = result.Value;
            _results = _set!.Progress.ToList();
            _index = _results.Count;
            _selectedChoice = null;
            _feedback = null;
            _showSummary = false;
            _allowLeave = false;
        } catch (Exception ex) {
            _set = null;
            Extension.ShowAlert(ex.Message, Variant.Filled, Snackbar, Severity.Error);
        } finally {
            _isLoading = false;
        }
    }

    private Variant OptionVariant(int choice) {
        if (_feedback != null) return choice == _feedback.Answer || choice == _feedback.Choice ? Variant.Filled : Variant.Outlined;
        return _selectedChoice == choice ? Variant.Filled : Variant.Outlined;
    }

    private Color OptionColor(int choice) {
        if (_feedback != null) {
            if (choice == _feedback.Answer) return Color.Success;
            return choice == _feedback.Choice ? Color.Error : Color.Default;
        }
        return _selectedChoice == choice ? Color.Primary : Color.Default;
    }

    private void SelectChoice(int choice) {
        if (_feedback != null) return;
        _selectedChoice = choice;
    }

    private async Task CheckAnswer() {
        if (_selectedChoice == null || _isProcessing) return;
        _isProcessing = true;
        try {
            var result = await Practice.CheckAnswer(_user!.Id, SetId, _index, _selectedChoice.Value);
            if (!result.IsSuccess) { Extension.ShowAlert(result.Error, Variant.Filled, Snackbar, Severity.Error); return; }
            _feedback = result.Value;
            _results.Add(result.Value!);
            if (_results.Count == _set!.Questions.Count) await Practice.DiscardProgress(_user.Id, SetId);
        } catch (Exception ex) {
            Extension.ShowAlert(ex.Message, Variant.Filled, Snackbar, Severity.Error);
        } finally {
            _isProcessing = false;
        }
    }

    private void NextQuestion() {
        _feedback = null;
        _selectedChoice = null;
        _index++;
        if (_index >= _set!.Questions.Count) _showSummary = true;
    }

    private async Task StartNextSet() {
        if (_isProcessing) return;
        _isProcessing = true;
        try {
            var result = await Practice.StartNextSet(_user!.Id, SetId, CancellationToken.None);
            if (!result.IsSuccess) { Extension.ShowAlert(result.Error, Variant.Filled, Snackbar, Severity.Error); return; }
            Navigation.NavigateTo("/Practice/" + result.Value);
        } catch (Exception ex) {
            Extension.ShowAlert(ex.Message, Variant.Filled, Snackbar, Severity.Error);
        } finally {
            _isProcessing = false;
        }
    }

    private async Task ConfirmLeaving(LocationChangingContext context) {
        if (_allowLeave || !HasUnfinishedPractice) return;
        context.PreventNavigation();
        _pendingUri = context.TargetLocation;
        var parameters = new DialogParameters<LeaveQuizDialog> {
            { x => x.SaveOrDiscard, SaveOrDiscardProgress }
        };
        var dialog = await DialogService.ShowAsync<LeaveQuizDialog>("Save your progress before leaving?", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false });
        var result = await dialog.Result;
        if (result == null || result.Canceled) return;
        _allowLeave = true;
        Navigation.NavigateTo(_pendingUri);
    }

    private async Task<string> SaveOrDiscardProgress(bool saveProgress) {
        var result = saveProgress
            ? await Practice.SaveProgress(_user!.Id, SetId, _results.Select(r => r.Choice).ToArray())
            : await Practice.DiscardProgress(_user!.Id, SetId);
        return result.IsSuccess ? "" : (result.Error.Length > 0 ? result.Error : "Something went wrong. Please try again.");
    }
    #endregion
}
