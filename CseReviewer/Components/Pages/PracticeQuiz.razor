@page "/Practice/{SetId:guid}"
@attribute [Authorize]
@inject PracticeService Practice
@inject CurrentUserAccessor Users
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>@(_set?.Title ?? "Practice") · Husay</PageTitle>

<NavigationLock OnBeforeInternalNavigation="ConfirmLeaving" ConfirmExternalNavigation="@HasUnfinishedPractice" />

@if (_isLoading) {
    <MudProgressLinear Indeterminate="true" />
} else if (_set == null) {
    <MudText Typo="Typo.h5">Practice set not found</MudText>
    <MudText Color="Color.Secondary" Class="mt-2">It may have been removed, or it belongs to a different account.</MudText>
    <MudButton Href="/" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.ArrowBack" Class="mt-4">Back to practice</MudButton>
} else {
    <div class="page-head">
        <div><MudButton Href="/" Variant="Variant.Text" Color="Color.Secondary" StartIcon="@Icons.Material.Outlined.ArrowBack" Class="mb-2 ml-n2">Back to practice</MudButton></div>
        <MudText Typo="Typo.overline" Color="Color.Primary">@_set.Level · @_set.Source · @_set.Difficulty</MudText>
        <MudText Typo="Typo.h4" Class="mt-1">@_set.Title</MudText>
    </div>

    <div style="max-width:780px">
        <MudStack Row="true" Justify="Justify.SpaceBetween">
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="numeric">@(_showSummary ? "Finished" : $"Question {_index + 1} of {_set.Questions.Count}")</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="numeric">@CorrectCount correct · @_results.Count answered</MudText>
        </MudStack>
        <div class="progress-line mt-2" role="progressbar" aria-valuenow="@((int)ProgressPercent)" aria-valuemin="0" aria-valuemax="100"><div style="width:@(((int)ProgressPercent).ToString())%"></div></div>

        @if (_showSummary) {
            <MudText Typo="Typo.overline" Color="Color.Primary" Class="mt-10 d-block">Result</MudText>
            <div class="score numeric mt-2">@CorrectCount<span style="font-size:0.45em;font-weight:400" class="ml-2">of @_results.Count correct</span></div>
            <MudText Color="Color.Secondary" Class="mt-3 measure">@ScorePercent% on this set. Open any question below to review the answer and the explanation.</MudText>
            <MudExpansionPanels Class="mt-8" Elevation="0" Outlined="true">
                @for (var i = 0; i < _set.Questions.Count; i++) {
                    var question = _set.Questions[i];
                    var result = _results[i];
                    <MudExpansionPanel>
                        <TitleContent>
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                                <MudText Typo="Typo.subtitle2" Color="@(result.Correct ? Color.Success : Color.Error)" Style="min-width:64px">@(result.Correct ? "Correct" : "Missed")</MudText>
                                <MudText>@question.Prompt</MudText>
                            </MudStack>
                        </TitleContent>
                        <ChildContent>
                            <MudText><strong>Answer:</strong> @question.Options[result.Answer]</MudText>
                            <MudText Color="Color.Secondary" Class="mt-2">@result.Explanation</MudText>
                            @foreach (var step in result.Steps) {
                                <MudText Typo="Typo.body2" Class="mt-1">@step</MudText>
                            }
                        </ChildContent>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-8" Disabled="@_isProcessing" OnClick="StartNextSet" EndIcon="@(_isProcessing ? null : Icons.Material.Outlined.ArrowForward)">
                @if (_isProcessing) {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Start another set like this
            </MudButton>
        } else {
            var current = _set.Questions[_index];
            <MudText Typo="Typo.overline" Color="Color.Primary" Class="mt-8 d-block">@_set.Category</MudText>
            <MudText Typo="Typo.h5" Class="mt-2">@current.Prompt</MudText>
            <MudStack Spacing="2" Class="mt-6">
                @for (var i = 0; i < current.Options.Length; i++) {
                    var choice = i;
                    <MudButton Variant="Variant.Text" DisableRipple="true" Class="@("option-row " + OptionClass(choice))" aria-pressed="@(_selectedChoice == choice ? "true" : "false")" OnClick="() => SelectChoice(choice)">
                        <span class="option-letter">@("ABCD"[choice])</span>
                        <span>@current.Options[choice]</span>
                    </MudButton>
                }
            </MudStack>
            @if (_feedback == null) {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-6" Disabled="@(_selectedChoice == null || _isProcessing)" OnClick="CheckAnswer"
                           StartIcon="@(_isProcessing ? null : Icons.Material.Outlined.Check)">
                    @if (_isProcessing) {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    Check answer
                </MudButton>
            } else {
                <div class="@("explain mt-6 " + (_feedback.Correct ? "is-correct" : "is-wrong"))" aria-live="polite">
                    <MudText Typo="Typo.subtitle1" Color="@(_feedback.Correct ? Color.Success : Color.Error)">@(_feedback.Correct ? "Correct" : "Not quite")</MudText>
                    <MudText Class="mt-1"><strong>Answer:</strong> @("ABCD"[_feedback.Answer]). @current.Options[_feedback.Answer]</MudText>
                    <MudText Color="Color.Secondary" Class="mt-2 measure">@_feedback.Explanation</MudText>
                    @if (_feedback.Steps.Length > 0) {
                        <MudText Typo="Typo.subtitle2" Class="mt-3">Worked solution</MudText>
                        <ol style="padding-left:20px;margin:4px 0 0 0;">
                            @foreach (var step in _feedback.Steps) {
                                <li><MudText Typo="Typo.body2" Inline="true">@step</MudText></li>
                            }
                        </ol>
                    }
                </div>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-5" OnClick="NextQuestion" EndIcon="@Icons.Material.Outlined.ArrowForward">
                    @(_index + 1 == _set.Questions.Count ? "See my results" : "Next question")
                </MudButton>
            }
        }
    </div>
}

@code {
    #region Properties
    [Parameter] public Guid SetId { get; set; }
    private StudySetDetail? _set;
    private AnswerFeedback? _feedback;
    private List<AnswerFeedback> _results = [];
    private CurrentUser? _user;
    private Guid _loadedSetId;
    private string _pendingUri = "/";
    private int _index;
    private int? _selectedChoice;
    private bool _isLoading = true;
    private bool _isProcessing;
    private bool _showSummary;
    private bool _allowLeave;
    private bool HasUnfinishedPractice => _set != null && _results.Count < _set.Questions.Count;
    private int CorrectCount => _results.Count(r => r.Correct);
    private int ScorePercent => _results.Count == 0 ? 0 : (int)Math.Round(CorrectCount * 100.0 / _results.Count, MidpointRounding.AwayFromZero);
    private double ProgressPercent => _set == null || _set.Questions.Count == 0 ? 0 : _results.Count * 100.0 / _set.Questions.Count;
    #endregion

    #region Lifecycle
    protected override async Task OnInitializedAsync() {
        _user = await Users.Get();
    }

    protected override async Task OnParametersSetAsync() {
        if (_loadedSetId == SetId) return;
        _loadedSetId = SetId;
        await LoadSet();
    }
    #endregion

    #region Methods
    private async Task LoadSet() {
        _isLoading = true;
        try {
            var result = await Practice.GetSet(_user!.Id, SetId);
            if (!result.IsSuccess) { _set = null; return; }
            _set = result.Value;
            _results = _set!.Progress.ToList();
            _index = _results.Count;
            _selectedChoice = null;
            _feedback = null;
            _showSummary = false;
            _allowLeave = false;
        } catch (Exception ex) {
            _set = null;
            Extension.ShowAlert(ex.Message, Variant.Filled, Snackbar, Severity.Error);
        } finally {
            _isLoading = false;
        }
    }

    private string OptionClass(int choice) {
        if (_feedback == null) return _selectedChoice == choice ? "is-selected" : "";
        if (choice == _feedback.Answer) return "is-correct is-locked";
        return choice == _feedback.Choice ? "is-wrong is-locked" : "is-locked";
    }

    private void SelectChoice(int choice) {
        if (_feedback != null) return;
        _selectedChoice = choice;
    }

    private async Task CheckAnswer() {
        if (_selectedChoice == null || _isProcessing) return;
        _isProcessing = true;
        try {
            var result = await Practice.CheckAnswer(_user!.Id, SetId, _index, _selectedChoice.Value);
            if (!result.IsSuccess) { Extension.ShowAlert(result.Error, Variant.Filled, Snackbar, Severity.Error); return; }
            _feedback = result.Value;
            _results.Add(result.Value!);
            if (_results.Count == _set!.Questions.Count) await Practice.DiscardProgress(_user.Id, SetId);
        } catch (Exception ex) {
            Extension.ShowAlert(ex.Message, Variant.Filled, Snackbar, Severity.Error);
        } finally {
            _isProcessing = false;
        }
    }

    private void NextQuestion() {
        _feedback = null;
        _selectedChoice = null;
        _index++;
        if (_index >= _set!.Questions.Count) _showSummary = true;
    }

    private async Task StartNextSet() {
        if (_isProcessing) return;
        _isProcessing = true;
        try {
            var result = await Practice.StartNextSet(_user!.Id, SetId, CancellationToken.None);
            if (!result.IsSuccess) { Extension.ShowAlert(result.Error, Variant.Filled, Snackbar, Severity.Error); return; }
            Navigation.NavigateTo("/Practice/" + result.Value);
        } catch (Exception ex) {
            Extension.ShowAlert(ex.Message, Variant.Filled, Snackbar, Severity.Error);
        } finally {
            _isProcessing = false;
        }
    }

    private async Task ConfirmLeaving(LocationChangingContext context) {
        if (_allowLeave || !HasUnfinishedPractice) return;
        context.PreventNavigation();
        _pendingUri = context.TargetLocation;
        var parameters = new DialogParameters<LeaveQuizDialog> {
            { x => x.SaveOrDiscard, SaveOrDiscardProgress }
        };
        var dialog = await DialogService.ShowAsync<LeaveQuizDialog>("Save your progress before leaving?", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false });
        var result = await dialog.Result;
        if (result == null || result.Canceled) return;
        _allowLeave = true;
        Navigation.NavigateTo(_pendingUri);
    }

    private async Task<string> SaveOrDiscardProgress(bool saveProgress) {
        var result = saveProgress
            ? await Practice.SaveProgress(_user!.Id, SetId, _results.Select(r => r.Choice).ToArray())
            : await Practice.DiscardProgress(_user!.Id, SetId);
        return result.IsSuccess ? "" : (result.Error.Length > 0 ? result.Error : "Something went wrong. Please try again.");
    }
    #endregion
}
