@page "/"
@attribute [Authorize]
@inject BankService Bank
@inject CurrentUserAccessor Users
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Husay · CSE Reviewer</PageTitle>

<MudText Typo="Typo.overline" Color="Color.Primary">Practice with purpose</MudText>
<MudText Typo="Typo.h4" Class="mt-1">Your next chapter starts here.</MudText>
<MudText Color="Color.Secondary" Class="mt-3 mb-6">Build a reviewer around what you need to learn. Answer at your own pace, understand every solution, and keep your favorite sets.</MudText>

@if (_user?.IsAdmin == true) {
    <ImportPanel OnBankUpdated="CheckBankAvailability" />
}

<MudGrid Class="mt-2">
    <MudItem xs="12" lg="8">
        <MudPaper Class="@AppTheme.LargeCardPadding">
            <form @onsubmit="CreatePracticeSet">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mb-6">
                    <MudAvatar Color="Color.Primary" Variant="Variant.Outlined"><MudIcon Icon="@Icons.Material.Filled.AutoAwesome" /></MudAvatar>
                    <div>
                        <MudText Typo="Typo.h6">Make it your reviewer</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">One focused set. A clearer understanding.</MudText>
                    </div>
                </MudStack>

                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="string" Label="Exam level" Variant="Variant.Outlined" Value="@_level" ValueChanged="@ChangeLevel">
                            <MudSelectItem T="string" Value="@("Professional")" />
                            <MudSelectItem T="string" Value="@("Subprofessional")" />
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="string" Label="Generation mode" Variant="Variant.Outlined" Value="@_mode" ValueChanged="@ChangeMode" ToStringFunc="@ModeLabel">
                            <MudSelectItem T="string" Value="@("bank")" />
                            <MudSelectItem T="string" Value="@("ai")" />
                        </MudSelect>
                    </MudItem>
                </MudGrid>

                <MudText Typo="Typo.overline" Class="mt-6">What would you like to practice?</MudText>
                <MudDivider Class="mb-3" />
                <MudGrid>
                    @foreach (var category in AllowedCategories) {
                        var chosen = category;
                        <MudItem xs="12" sm="6">
                            <MudButton Variant="Variant.Outlined" Color="@(chosen == _category ? Color.Primary : Color.Default)" FullWidth="true"
                                       Style="@AppTheme.CategoryButtonStyle"
                                       aria-pressed="@(chosen == _category ? "true" : "false")" OnClick="() => SelectCategory(chosen)">
                                <div>
                                    <MudText Typo="Typo.subtitle2">@chosen</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@_categoryHints[Array.IndexOf(_categories, chosen)]</MudText>
                                </div>
                            </MudButton>
                        </MudItem>
                    }
                </MudGrid>

                <MudTextField T="string" Label="Your focus (optional, AI mode)" Variant="Variant.Outlined" Lines="3" Disabled="true" Class="mt-6"
                              Placeholder="e.g. Percentages and ratios in everyday situations. Show me how to solve each problem." />

                <MudGrid Class="mt-2">
                    <MudItem xs="12" sm="6">
                        <MudSelect T="string" Label="Difficulty" Variant="Variant.Outlined" Value="@_difficulty" ValueChanged="@ChangeDifficulty">
                            <MudSelectItem T="string" Value="@("Easy")" />
                            <MudSelectItem T="string" Value="@("Moderate")" />
                            <MudSelectItem T="string" Value="@("Hard")" />
                            <MudSelectItem T="string" Value="@("Mixed")" />
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        @if (IsBankMode) {
                            <MudNumericField T="int" Label="Questions" Variant="Variant.Outlined" Min="1" Max="@Math.Max(1, _bankAvailable)" Class="text-align-right"
                                             @bind-Value="_bankCount" Immediate="true" HelperText="@_bankStatus" />
                        } else {
                            <MudNumericField T="int" Label="Questions" Variant="Variant.Outlined" Value="20" Disabled="true" Class="text-align-right" />
                        }
                    </MudItem>
                </MudGrid>

                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-4">@ModeNote</MudText>
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-4" Size="Size.Large"
                           Disabled="@(!CanCreate)" StartIcon="@(_isProcessing ? null : Icons.Material.Filled.ArrowForward)">
                    @if (_isProcessing) {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        @_buttonText
                    } else {
                        @("Create practice set")
                    }
                </MudButton>
            </form>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" lg="4">
        <MudStack Spacing="3">
            <MudPaper Class="@AppTheme.CardPadding">
                <MudText Typo="Typo.overline" Color="Color.Primary">Learn, don't just guess</MudText>
                <MudText Typo="Typo.h6" Class="mb-3">Every answer is a lesson.</MudText>
                <MudText Typo="Typo.subtitle2" Color="Color.Primary">01 Make it personal</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">Pick a subject and tell the AI where you need practice.</MudText>
                <MudText Typo="Typo.subtitle2" Color="Color.Primary">02 Understand the why</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">Get instant feedback and worked numerical solutions.</MudText>
                <MudText Typo="Typo.subtitle2" Color="Color.Primary">03 Keep growing</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Save a set and revisit it whenever you're ready.</MudText>
            </MudPaper>
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Info">
                <strong>A reviewer, not an official exam.</strong> Original practice inspired by CSC subject coverage. AI can make mistakes; verify any doubtful explanation.
            </MudAlert>
        </MudStack>
    </MudItem>
</MudGrid>

@code {
    #region Properties
    [SupplyParameterFromQuery(Name = "view")] public string? RequestedView { get; set; }
    [SupplyParameterFromQuery(Name = "code")] public string? SharedCode { get; set; }
    private static readonly string[] _categories = [
        "All 4 Subjects (Final Mock Exam)",
        "Numerical Ability",
        "Verbal Ability",
        "Analytical Ability",
        "Clerical Ability",
        "General Information"
    ];
    private static readonly string[] _categoryHints = [
        "Comprehensive 180-item exam covering all 4 subjects",
        "Numbers, patterns & word problems",
        "Words, grammar & comprehension",
        "Logic, analogies & conclusions",
        "Filing, spelling & attention to detail",
        "Public service, ethics & citizenship"
    ];
    private CurrentUser? _user;
    private string _level = "Professional";
    private string _mode = "bank";
    private string _category = _categories[0];
    private string _difficulty = "Moderate";
    private string _bankStatus = "";
    private string _buttonText = "";
    private int _bankCount = 20;
    private int _bankAvailable;
    private int _bankCheckVersion;
    private bool _isProcessing;
    private bool IsBankMode => _mode == "bank";
    private bool IsFinalExam => _bankCount >= 100 || _category == _categories[0];
    private bool CanCreate => IsBankMode && !_isProcessing && _bankAvailable > 0 && _bankCount >= 1 && _bankCount <= _bankAvailable;
    private IEnumerable<string> AllowedCategories => _categories.Where(IsCategoryAllowed);
    private string ModeNote {
        get {
            if (!IsBankMode) return "AI custom questions are not available yet. Please choose Custom questions · Database to start practicing.";
            if (IsFinalExam) return $"Database Final Exam ({_bankCount} questions): Randomly draws from your imported database across {(_category == _categories[0] ? "all 4 subjects" : _category)}. You will be prompted if available questions are fewer than requested.";
            return "Randomly selects the shared database questions by subject, level and difficulty. Save your progress when leaving an unfinished set. No AI call. Ask an administrator to add more questions if there are not enough matching items.";
        }
    }
    #endregion

    #region Lifecycle
    protected override async Task OnInitializedAsync() {
        if (RedirectOldAddress()) return;
        _user = await Users.Get();
        await CheckBankAvailability();
    }
    #endregion

    #region Methods
    private static string ModeLabel(string mode) => mode == "bank" ? "Custom questions · Database" : "AI · Custom questions (not available yet)";

    private bool RedirectOldAddress() {
        if (RequestedView == "multiplayer") Navigation.NavigateTo("/Multiplayer" + (string.IsNullOrEmpty(SharedCode) ? "" : "?code=" + Uri.EscapeDataString(SharedCode)), replace: true);
        else if (RequestedView == "admin") Navigation.NavigateTo("/Administration", replace: true);
        else if (RequestedView == "library") Navigation.NavigateTo("/My-Saved-Sets", replace: true);
        else return false;
        return true;
    }

    private bool IsCategoryAllowed(string category) {
        if (_level == "Professional" && category == "Clerical Ability") return false;
        return !(_level == "Subprofessional" && category == "Analytical Ability");
    }

    private async Task ChangeLevel(string level) {
        _level = level;
        if (!IsCategoryAllowed(_category)) _category = AllowedCategories.First();
        await CheckBankAvailability();
    }

    private async Task ChangeMode(string mode) {
        _mode = mode;
        await CheckBankAvailability();
    }

    private async Task ChangeDifficulty(string difficulty) {
        _difficulty = difficulty;
        await CheckBankAvailability();
    }

    private async Task SelectCategory(string category) {
        _category = category;
        await CheckBankAvailability();
    }

    private async Task CheckBankAvailability() {
        if (!IsBankMode) return;
        var version = ++_bankCheckVersion;
        _bankStatus = "Checking available questions…";
        try {
            var result = await Bank.CheckBank(new BankCheckRequest(_category, _level, _difficulty, 1));
            if (version != _bankCheckVersion) return;
            if (!result.IsSuccess) { Extension.ShowAlert("Unable to check availability. " + result.Error, Variant.Filled, Snackbar, Severity.Error); return; }
            _bankAvailable = result.Value!.Available;
            if (_bankAvailable > 0) _bankCount = Math.Min(Math.Max(1, _bankCount), _bankAvailable);
            _bankStatus = _bankAvailable > 0
                ? $"{_bankAvailable:N0} matching questions available. Enter 1–{_bankAvailable:N0}."
                : "No matching questions. Try Mixed or ask an administrator to import more.";
        } catch (Exception ex) {
            if (version == _bankCheckVersion) Extension.ShowAlert("Unable to check availability. " + ex.Message, Variant.Filled, Snackbar, Severity.Error);
        }
    }

    private async Task CreatePracticeSet() {
        if (!CanCreate) return;
        _isProcessing = true;
        _buttonText = "Checking question database…";
        try {
            var check = await Bank.CheckBank(new BankCheckRequest(_category, _level, _difficulty, _bankCount));
            if (!check.IsSuccess) { Extension.ShowAlert(check.Error, Variant.Filled, Snackbar, Severity.Error); return; }
            if (check.Value!.Available == 0) {
                Extension.ShowAlert($"No matching questions found in your database for {_category} ({_level}). Ask an administrator to add matching questions.", Variant.Filled, Snackbar, Severity.Warning);
                return;
            }
            if (!check.Value.IsEnough) { await AskToContinueWithFewerQuestions(check.Value); return; }
            await CreateSetWithCount(_bankCount, false);
        } catch (Exception ex) {
            Extension.ShowAlert(ex.Message, Variant.Filled, Snackbar, Severity.Error);
        } finally {
            _isProcessing = false;
        }
    }

    private async Task AskToContinueWithFewerQuestions(BankCheck shortfall) {
        var parameters = new DialogParameters<InsufficientQuestionsDialog> {
            { x => x.Shortfall, shortfall },
            { x => x.IsFinalExam, IsFinalExam }
        };
        var dialog = await DialogService.ShowAsync<InsufficientQuestionsDialog>("Questions in database", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result == null || result.Canceled) return;
        await CreateSetWithCount(shortfall.Available, true);
    }

    private async Task CreateSetWithCount(int count, bool allowPartial) {
        _buttonText = count >= 100 ? $"Preparing {count}-question Final Exam…" : $"Preparing {count} questions…";
        var result = await Bank.CreateBankSet(_user!.Id, new BankRequest(_category, _level, _difficulty, count, allowPartial));
        if (!result.IsSuccess) { Extension.ShowAlert(result.Error, Variant.Filled, Snackbar, Severity.Error); return; }
        Navigation.NavigateTo("/Practice/" + result.Value!.Id);
    }
    #endregion
}
