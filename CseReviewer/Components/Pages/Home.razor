@page "/"
@attribute [Authorize]
@inject BankService Bank
@inject CurrentUserAccessor Users
@inject NavigationManager Navigation

<PageTitle>Husay · CSE Reviewer</PageTitle>

<NoticeBanner Message="@_notice" />

<p class="eyebrow">PRACTICE WITH PURPOSE</p>
<h1 class="text-3xl md:text-4xl font-bold tracking-tight mt-3">Your next chapter starts here.</h1>
<p class="mt-4 text-slate-500 max-w-2xl leading-7">Build a reviewer around what you need to learn. Answer at your own pace, understand every solution, and keep your favorite sets.</p>

@if (_user?.IsAdmin == true) {
    <ImportPanel OnBankUpdated="CheckBankAvailability" />
}

<div class="grid xl:grid-cols-[1fr_280px] gap-7 mt-9">
    <form class="panel p-6 md:p-8" @onsubmit="CreatePracticeSet">
        <div class="flex gap-3 items-center mb-7">
            <span class="bg-teal-50 text-teal-800 rounded-xl p-3">✦</span>
            <div>
                <h2 class="font-bold text-lg">Make it your reviewer</h2>
                <p class="text-sm text-slate-500">One focused set. A clearer understanding.</p>
            </div>
        </div>

        <div class="grid sm:grid-cols-2 gap-5">
            <label>Exam level
                <select @bind="_level" @bind:after="ApplyFilterChange">
                    <option>Professional</option>
                    <option>Subprofessional</option>
                </select>
            </label>
            <label>Generation mode
                <select @bind="_mode" @bind:after="ApplyFilterChange">
                    <option value="bank">Custom questions · Database</option>
                    <option value="ai">AI · Custom questions (not available yet)</option>
                </select>
            </label>
        </div>

        <fieldset class="mt-6">
            <legend class="text-sm font-semibold mb-3">What would you like to practice?</legend>
            <div class="grid sm:grid-cols-2 gap-3">
                @foreach (var category in AllowedCategories) {
                    var chosen = category;
                    <button type="button" class="subject @(chosen == _category ? "selected" : "")" aria-pressed="@(chosen == _category)" @onclick="() => SelectCategory(chosen)">
                        <strong>@chosen</strong>
                        <span class="block text-xs text-slate-500 mt-2">@_categoryHints[Array.IndexOf(_categories, chosen)]</span>
                    </button>
                }
            </div>
        </fieldset>

        <label class="block mt-6">Your focus
            <span class="text-slate-400 font-normal">(optional, AI mode)</span>
            <textarea rows="3" maxlength="500" disabled placeholder="e.g. Percentages and ratios in everyday situations. Show me how to solve each problem."></textarea>
        </label>

        <div class="grid grid-cols-2 gap-5 mt-5">
            <label>Difficulty
                <select @bind="_difficulty" @bind:after="ApplyFilterChange">
                    <option>Easy</option>
                    <option>Moderate</option>
                    <option>Hard</option>
                    <option>Mixed</option>
                </select>
            </label>
            <label>Questions
                @if (IsBankMode) {
                    <input type="number" min="1" max="@_bankAvailable" step="1" required @bind="_bankCount" @bind:event="oninput">
                } else {
                    <select disabled>
                        <option>20</option>
                    </select>
                }
                @if (IsBankMode) {
                    <span class="block text-xs text-slate-500 mt-2" aria-live="polite">@_bankStatus</span>
                }
            </label>
        </div>

        <p class="text-xs text-slate-500 leading-5 mt-5">@ModeNote</p>
        <button class="primary w-full mt-6" type="submit" disabled="@(!CanCreate)">
            @(_isProcessing ? _buttonText : "Create practice set →")
        </button>
    </form>

    <div class="space-y-5">
        <div class="panel p-6">
            <p class="eyebrow">LEARN, DON'T JUST GUESS</p>
            <h2 class="font-bold text-xl mt-3">Every answer is a lesson.</h2>
            <ol class="mt-6 space-y-6 text-sm">
                <li>
                    <b class="text-teal-700">01 &nbsp; Make it personal</b>
                    <p class="mt-2 text-slate-500">Pick a subject and tell the AI where you need practice.</p>
                </li>
                <li>
                    <b class="text-teal-700">02 &nbsp; Understand the why</b>
                    <p class="mt-2 text-slate-500">Get instant feedback and worked numerical solutions.</p>
                </li>
                <li>
                    <b class="text-teal-700">03 &nbsp; Keep growing</b>
                    <p class="mt-2 text-slate-500">Save a set and revisit it whenever you're ready.</p>
                </li>
            </ol>
        </div>
        <div class="rounded-2xl bg-amber-50 p-6 text-sm text-amber-900">
            <b>A reviewer, not an official exam.</b>
            <p class="mt-2 leading-6">Original practice inspired by CSC subject coverage. AI can make mistakes; verify any doubtful explanation.</p>
        </div>
    </div>
</div>

@if (_shortfall != null) {
    <ModalDialog Title="Questions in database">
        <p class="mt-4 leading-6 text-slate-600">You requested @_shortfall.Requested questions for @(IsFinalExam ? "the 4 exam subjects combined" : _shortfall.Category), but only @_shortfall.Available matching @(_shortfall.Available == 1 ? "question is" : "questions are") available in the database.</p>
        @if (_shortfall.Breakdown.Count > 1) {
            <div class="mt-4 p-3 rounded-xl bg-slate-100 text-xs text-slate-600 leading-5">
                <strong>Subject breakdown:</strong><br>
                @string.Join(" · ", _shortfall.Breakdown.Select(b => $"{b.Category}: {b.Count} available"))
            </div>
        }
        <p class="font-semibold text-slate-800 mt-5">Some questions are not enough. Do you want to continue?</p>
        <div class="flex flex-wrap gap-3 mt-6">
            <button type="button" class="primary" disabled="@_isProcessing" @onclick="ContinueWithAvailable">Yes, continue with @_shortfall.Available questions →</button>
            <button type="button" class="secondary" disabled="@_isProcessing" @onclick="CancelShortfall">Cancel</button>
        </div>
    </ModalDialog>
}

@code {
    #region Properties
    [SupplyParameterFromQuery(Name = "view")] public string? RequestedView { get; set; }
    [SupplyParameterFromQuery(Name = "code")] public string? SharedCode { get; set; }
    private static readonly string[] _categories = [
        "All 4 Subjects (Final Mock Exam)",
        "Numerical Ability",
        "Verbal Ability",
        "Analytical Ability",
        "Clerical Ability",
        "General Information"
    ];
    private static readonly string[] _categoryHints = [
        "Comprehensive 180-item exam covering all 4 subjects",
        "Numbers, patterns & word problems",
        "Words, grammar & comprehension",
        "Logic, analogies & conclusions",
        "Filing, spelling & attention to detail",
        "Public service, ethics & citizenship"
    ];
    private CurrentUser? _user;
    private BankCheck? _shortfall;
    private string _level = "Professional";
    private string _mode = "bank";
    private string _category = _categories[0];
    private string _difficulty = "Moderate";
    private string _notice = "";
    private string _bankStatus = "";
    private string _buttonText = "";
    private int _bankCount = 20;
    private int _bankAvailable;
    private int _bankCheckVersion;
    private bool _isProcessing;
    private bool IsBankMode => _mode == "bank";
    private bool IsFinalExam => _bankCount >= 100 || _category == _categories[0];
    private bool CanCreate => IsBankMode && !_isProcessing && _bankAvailable > 0 && _bankCount >= 1 && _bankCount <= _bankAvailable;
    private IEnumerable<string> AllowedCategories => _categories.Where(IsCategoryAllowed);
    private string ModeNote {
        get {
            if (!IsBankMode) return "AI custom questions are not available yet. Please choose Custom questions · Database to start practicing.";
            if (IsFinalExam) return $"Database Final Exam ({_bankCount} questions): Randomly draws from your imported database across {(_category == _categories[0] ? "all 4 subjects" : _category)}. You will be prompted if available questions are fewer than requested.";
            return "Randomly selects the shared database questions by subject, level and difficulty. Save your progress when leaving an unfinished set. No AI call. Ask an administrator to add more questions if there are not enough matching items.";
        }
    }
    #endregion

    #region Lifecycle
    protected override async Task OnInitializedAsync() {
        if (RedirectOldAddress()) return;
        _user = await Users.Get();
        await CheckBankAvailability();
    }
    #endregion

    #region Methods
    private bool RedirectOldAddress() {
        if (RequestedView == "multiplayer") Navigation.NavigateTo("/Multiplayer" + (string.IsNullOrEmpty(SharedCode) ? "" : "?code=" + Uri.EscapeDataString(SharedCode)), replace: true);
        else if (RequestedView == "admin") Navigation.NavigateTo("/Administration", replace: true);
        else if (RequestedView == "library") Navigation.NavigateTo("/My-Saved-Sets", replace: true);
        else return false;
        return true;
    }

    private bool IsCategoryAllowed(string category) {
        if (_level == "Professional" && category == "Clerical Ability") return false;
        return !(_level == "Subprofessional" && category == "Analytical Ability");
    }

    private async Task SelectCategory(string category) {
        _category = category;
        await CheckBankAvailability();
    }

    private async Task ApplyFilterChange() {
        if (!IsCategoryAllowed(_category)) _category = AllowedCategories.First();
        await CheckBankAvailability();
    }

    private async Task CheckBankAvailability() {
        if (!IsBankMode) return;
        var version = ++_bankCheckVersion;
        _bankStatus = "Checking available questions…";
        try {
            var result = await Bank.CheckBank(new BankCheckRequest(_category, _level, _difficulty, 1));
            if (version != _bankCheckVersion) return;
            if (!result.IsSuccess) { _bankStatus = "Unable to check availability. " + result.Error; return; }
            _bankAvailable = result.Value!.Available;
            if (_bankAvailable > 0) _bankCount = Math.Min(Math.Max(1, _bankCount), _bankAvailable);
            _bankStatus = _bankAvailable > 0
                ? $"{_bankAvailable:N0} matching questions available. Enter 1–{_bankAvailable:N0}."
                : "No matching questions. Try Mixed or ask an administrator to import more.";
        } catch (Exception ex) {
            if (version == _bankCheckVersion) _bankStatus = "Unable to check availability. " + ex.Message;
        }
    }

    private async Task CreatePracticeSet() {
        if (!CanCreate) return;
        _isProcessing = true;
        _notice = "";
        _buttonText = "Checking question database…";
        try {
            var check = await Bank.CheckBank(new BankCheckRequest(_category, _level, _difficulty, _bankCount));
            if (!check.IsSuccess) { _notice = check.Error; return; }
            if (check.Value!.Available == 0) {
                _notice = $"No matching questions found in your database for {_category} ({_level}). Ask an administrator to add matching questions.";
                return;
            }
            if (!check.Value.IsEnough) { _shortfall = check.Value; return; }
            await CreateSetWithCount(_bankCount, false);
        } catch (Exception ex) {
            _notice = ex.Message;
        } finally {
            _isProcessing = false;
        }
    }

    private async Task ContinueWithAvailable() {
        if (_shortfall == null || _isProcessing) return;
        var available = _shortfall.Available;
        _shortfall = null;
        _isProcessing = true;
        try { await CreateSetWithCount(available, true); }
        catch (Exception ex) { _notice = ex.Message; }
        finally { _isProcessing = false; }
    }

    private void CancelShortfall() {
        _shortfall = null;
    }

    private async Task CreateSetWithCount(int count, bool allowPartial) {
        _buttonText = count >= 100 ? $"Preparing {count}-question Final Exam…" : $"Preparing {count} questions…";
        var result = await Bank.CreateBankSet(_user!.Id, new BankRequest(_category, _level, _difficulty, count, allowPartial));
        if (!result.IsSuccess) { _notice = result.Error; return; }
        Navigation.NavigateTo("/Practice/" + result.Value!.Id);
    }
    #endregion
}
