@page "/My-Saved-Sets"
@attribute [Authorize]
@inject PracticeService Practice
@inject CurrentUserAccessor Users
@inject ISnackbar Snackbar

<PageTitle>My saved sets · Husay</PageTitle>

<MudText Typo="Typo.overline" Color="Color.Primary">Your personal library</MudText>
<MudText Typo="Typo.h4" Class="mt-1">Saved for your next study session.</MudText>
<MudText Color="Color.Secondary" Class="mt-3">Your sets and saved progress are stored in the database and linked to your account.</MudText>

@if (_isLoading) {
    <MudProgressLinear Indeterminate="true" Class="mt-6" />
} else if (_sets.Count == 0) {
    <MudPaper Class="pa-8 mt-6">
        <MudText Typo="Typo.h6">A fresh start for your library.</MudText>
        <MudText Color="Color.Secondary" Class="mt-2">Your unfinished sets appear here when you choose Save progress before leaving a quiz.</MudText>
    </MudPaper>
} else {
    <MudGrid Class="mt-4">
        @foreach (var set in _sets) {
            <MudItem xs="12" md="6">
                <MudCard>
                    <MudCardContent>
                        <MudText Typo="Typo.overline" Color="Color.Primary">@set.Source · @set.Count questions</MudText>
                        <MudText Typo="Typo.h6">@set.Title</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@set.Level · @set.Difficulty</MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="@("/Practice/" + set.Id)" EndIcon="@Icons.Material.Filled.ArrowForward">Resume practice</MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@code {
    #region Properties
    private List<StudySetSummary> _sets = [];
    private bool _isLoading = true;
    #endregion

    #region Lifecycle
    protected override async Task OnInitializedAsync() {
        try {
            var user = await Users.Get();
            _sets = await Practice.GetSavedSets(user.Id);
        } catch (Exception ex) {
            Extension.ShowAlert(ex.Message, Variant.Filled, Snackbar, Severity.Error);
        } finally {
            _isLoading = false;
        }
    }
    #endregion
}
