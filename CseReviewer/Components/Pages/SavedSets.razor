@page "/My-Saved-Sets"
@attribute [Authorize]
@inject PracticeService Practice
@inject CurrentUserAccessor Users
@inject ISnackbar Snackbar

<PageTitle>Saved sets · Husay</PageTitle>

<div class="page-head">
    <MudText Typo="Typo.overline" Color="Color.Primary">Saved sets</MudText>
    <MudText Typo="Typo.h3" Class="mt-1">Pick up where you left off</MudText>
    <MudText Color="Color.Secondary" Class="mt-3 measure">Sets you saved partway through are listed here, with the questions you have already answered.</MudText>
</div>

@if (_isLoading) {
    <MudProgressLinear Indeterminate="true" />
} else if (_sets.Count == 0) {
    <MudText Typo="Typo.h6">Nothing saved yet</MudText>
    <MudText Color="Color.Secondary" Class="mt-2 measure">When you leave a practice set before finishing, choose Save progress and it will appear here.</MudText>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/" Class="mt-4" StartIcon="@Icons.Material.Outlined.PlayArrow">Start a practice set</MudButton>
} else {
    <div class="row-list">
        @foreach (var set in _sets) {
            <div class="row-item">
                <div class="grow">
                    <MudText Typo="Typo.h6">@set.Title</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@set.Level · @set.Difficulty · @set.Count questions · @set.Source</MudText>
                </div>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="@("/Practice/" + set.Id)" EndIcon="@Icons.Material.Outlined.ArrowForward">Resume</MudButton>
            </div>
        }
    </div>
}

@code {
    #region Properties
    private List<StudySetSummary> _sets = [];
    private bool _isLoading = true;
    #endregion

    #region Lifecycle
    protected override async Task OnInitializedAsync() {
        try {
            var user = await Users.Get();
            _sets = await Practice.GetSavedSets(user.Id);
        } catch (Exception ex) {
            Extension.ShowAlert(ex.Message, Variant.Filled, Snackbar, Severity.Error);
        } finally {
            _isLoading = false;
        }
    }
    #endregion
}
