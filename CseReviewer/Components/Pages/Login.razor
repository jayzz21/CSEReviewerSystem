@page "/Login"
@page "/Register"
@layout AuthLayout
@using System.Text.RegularExpressions
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>@(IsRegisterPage ? "Create account" : "Sign in") · Husay</PageTitle>

@if (IsRegisterPage) {
    <MudText Typo="Typo.h4">Create an account</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">Choose a username and a password of at least 12 characters.</MudText>
    @if (_error.Length > 0) {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4">@_error</MudAlert>
    }
    <form @onsubmit="CreateAccount">
        <MudStack Spacing="3" Class="mt-6">
            <MudTextField T="string" Label="Username" Variant="Variant.Outlined" @bind-Value="_username" Immediate="true" MaxLength="30"
                          HelperText="3-30 letters, numbers or underscores." Disabled="@_isSubmitting"
                          UserAttributes="@(new Dictionary<string, object> { { "autocomplete", "username" } })" />
            <MudTextField T="string" Label="Password" Variant="Variant.Outlined" InputType="@PasswordInputType" @bind-Value="_password" Immediate="true" MaxLength="128"
                          HelperText="At least 12 characters." Disabled="@_isSubmitting"
                          Adornment="Adornment.End" AdornmentIcon="@PasswordIcon" OnAdornmentClick="TogglePasswordVisibility" AdornmentAriaLabel="Show or hide password"
                          UserAttributes="@(new Dictionary<string, object> { { "autocomplete", "new-password" } })" />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Disabled="@_isSubmitting"
                       StartIcon="@(_isSubmitting ? null : Icons.Material.Filled.PersonAdd)">
                @if (_isSubmitting) {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Create account
            </MudButton>
        </MudStack>
    </form>
    <hr class="rule mt-8" />
    <MudText Typo="Typo.body2" Class="mt-4">Already have an account? <MudLink Href="@("/Login" + ReturnUrlQuery)" Typo="Typo.body2">Sign in</MudLink></MudText>
} else {
    <MudText Typo="Typo.h4">Sign in</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">Use the username and password for your account.</MudText>
    @if (Registered == "1" && _error.Length == 0) {
        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mt-4">Account created. Sign in with your username and password.</MudAlert>
    }
    @if (_error.Length > 0) {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4">@_error</MudAlert>
    }
    <form @onsubmit="SignIn">
        <MudStack Spacing="3" Class="mt-6">
            <MudTextField T="string" Label="Username" Variant="Variant.Outlined" @bind-Value="_username" Immediate="true" MaxLength="254" Disabled="@_isSubmitting"
                          UserAttributes="@(new Dictionary<string, object> { { "autocomplete", "username" } })" />
            <MudTextField T="string" Label="Password" Variant="Variant.Outlined" InputType="@PasswordInputType" @bind-Value="_password" Immediate="true" MaxLength="128" Disabled="@_isSubmitting"
                          Adornment="Adornment.End" AdornmentIcon="@PasswordIcon" OnAdornmentClick="TogglePasswordVisibility" AdornmentAriaLabel="Show or hide password"
                          UserAttributes="@(new Dictionary<string, object> { { "autocomplete", "current-password" } })" />
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Disabled="@_isSubmitting"
                       StartIcon="@(_isSubmitting ? null : Icons.Material.Filled.Login)">
                @if (_isSubmitting) {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Sign in
            </MudButton>
        </MudStack>
    </form>
    <hr class="rule mt-8" />
    <MudText Typo="Typo.body2" Class="mt-4">No account yet? <MudLink Href="/Register" Typo="Typo.body2">Create one</MudLink></MudText>
}

@code {
    #region Properties
    [SupplyParameterFromQuery(Name = "registered")] public string? Registered { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
    private string _username = "";
    private string _password = "";
    private string _error = "";
    private bool _showPassword;
    private bool _isSubmitting;
    private bool IsRegisterPage => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("Register", StringComparison.OrdinalIgnoreCase);
    private InputType PasswordInputType => _showPassword ? InputType.Text : InputType.Password;
    private string PasswordIcon => _showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility;
    private string SafeReturnUrl {
        get {
            var isLocalPath = !string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//") && !ReturnUrl.StartsWith("/\\");
            return isLocalPath ? ReturnUrl! : "";
        }
    }
    private string ReturnUrlQuery => SafeReturnUrl.Length == 0 ? "" : "?returnUrl=" + Uri.EscapeDataString(SafeReturnUrl);
    #endregion

    #region Methods
    private void TogglePasswordVisibility() {
        _showPassword = !_showPassword;
    }

    private string ErrorText(AuthResponse response) {
        if (response.Status == 429) return "Too many attempts. Wait one minute and try again.";
        return response.Error.Length > 0 ? response.Error : "Request failed. Please retry.";
    }

    private async Task SignIn() {
        if (_isSubmitting) return;
        _error = "";
        if (string.IsNullOrWhiteSpace(_username) || string.IsNullOrEmpty(_password)) {
            _error = "Enter your username and password.";
            return;
        }
        _isSubmitting = true;
        try {
            var response = await JS.InvokeAsync<AuthResponse>("husayAuth.post", "login", new { login = _username.Trim(), password = _password });
            if (response.Status != 200) { _error = ErrorText(response); return; }
            _password = "";
            var destination = SafeReturnUrl.Length == 0 ? "/" : SafeReturnUrl;
            Navigation.NavigateTo(response.MustChangePassword ? "/Change-Password" + ReturnUrlQuery : destination, forceLoad: true);
        } catch (Exception ex) {
            Extension.ShowAlert(ex.Message, Variant.Filled, Snackbar, Severity.Error);
        } finally {
            _isSubmitting = false;
        }
    }

    private async Task CreateAccount() {
        if (_isSubmitting) return;
        _error = "";
        if (!Regex.IsMatch(_username ?? "", "^[A-Za-z0-9_]{3,30}$")) {
            _error = "Use a 3-30 character username with letters, numbers or underscores.";
            return;
        }
        if (_password.Length < 12 || _password.Length > 128) {
            _error = "Use a password of 12-128 characters.";
            return;
        }
        _isSubmitting = true;
        try {
            var response = await JS.InvokeAsync<AuthResponse>("husayAuth.post", "register", new { username = _username, password = _password });
            if (response.Status != 200) { _error = ErrorText(response); return; }
            _password = "";
            Navigation.NavigateTo("/Login?registered=1" + ReturnUrlQuery.Replace("?", "&"));
        } catch (Exception ex) {
            Extension.ShowAlert(ex.Message, Variant.Filled, Snackbar, Severity.Error);
        } finally {
            _isSubmitting = false;
        }
    }
    #endregion
}
